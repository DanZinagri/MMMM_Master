<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Rimsenal Xenotype Pack - Harana: agile striker loses its +5 melee dodge and its x0.7 melee cooldown and now only cuts
		aiming delay (x0.8, was x0.7); Harana lose the quick movement gene.
		This folder loads when a Rimsenal xenotype pack is active (see loadFolders.xml); each block sits in a subfolder gated on its mods.
		Verified against Harana 1.6.
	-->
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/GeneDef[defName="AgileStriker"]/statOffsets</xpath>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="AgileStriker"]/statFactors</xpath>
		<value>
			<statFactors>
				<AimingDelayFactor>0.8</AimingDelayFactor>
			</statFactors>
		</value>
	</Operation>
	<Operation Class="PatchOperationRemove">
		<xpath>/Defs/XenotypeDef[defName="Harana"]/genes/li[text()="MoveSpeed_Quick"]</xpath>
	</Operation>

</Patch>
