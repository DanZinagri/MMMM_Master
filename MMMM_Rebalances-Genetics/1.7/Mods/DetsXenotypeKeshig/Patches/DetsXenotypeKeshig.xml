<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		The Keshig xenotype gains Alpha Genes' medium natural armour.
		This folder only loads when Det's Xenotypes - Keshig is active (see loadFolders.xml); Alpha Genes is gated on
		the operation because the gene comes from there.
		Verified against Keshig 1.6: the xenotype does not already list AG_ArmourMedium.
	-->
	<!--
		The mod gate sits on an <li> inside a sequence, not on the <Operation> itself: RimWorld reads
		MayRequire only on list elements, so an <Operation MayRequire="..."> node loads and applies
		unconditionally. Do not flatten this wrapper away.
	-->
	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationAdd" MayRequire="sarg.alphagenes">
				<xpath>Defs/XenotypeDef[defName="DV_Keshig"]/genes</xpath>
				<value>
					<li>AG_ArmourMedium</li>
				</value>
			</li>
		</operations>
	</Operation>

</Patch>
