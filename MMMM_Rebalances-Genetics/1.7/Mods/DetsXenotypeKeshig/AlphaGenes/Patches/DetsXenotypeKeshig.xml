<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		The Keshig xenotype gains Alpha Genes' medium natural armour.
		This folder only loads when Det's Xenotypes - Keshig is active (see loadFolders.xml); Alpha Genes is gated by subfolder because the gene comes from there.
		Verified against Keshig 1.6: the xenotype does not already list AG_ArmourMedium.
	-->
	<!--
		Operations that also need another mod sit in a subfolder gated on it in loadFolders.xml. Do not flatten this wrapper away.
	-->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/XenotypeDef[defName="DV_Keshig"]/genes</xpath>
		<value>
			<li>AG_ArmourMedium</li>
		</value>
	</Operation>

</Patch>
