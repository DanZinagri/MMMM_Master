<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.7/Mods/Biotech/Patches/GeneRebalance.xml: the operations that also need Vanilla Races Expanded - Highmate. -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/HediffDef[defName="VRE_PsychicBondBloodlust"]/stages/li/statFactors</xpath>
		<value>
			<statOffsets>
				<MeleeDamageFactor>0.2</MeleeDamageFactor>
			</statOffsets>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="VRE_RecessiveGenome"]/biostatMet</xpath>
		<value>
			<biostatMet>0</biostatMet>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="VRE_DominantGenome"]/biostatMet</xpath>
		<value>
			<biostatMet>-1</biostatMet>
		</value>
	</Operation>

</Patch>
