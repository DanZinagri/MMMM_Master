				<xpath>Defs/XenotypeDef[defName="BS_NanomachineVampire"]/genes/li[text()="HemogenDrain"]</xpath>
			</match>
		</match>
	</Operation>
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/XenotypeDef[defName="BS_ActualGiantFreakinRobot"]/genes/li[text()="ArchiteMetabolism"]</xpath>
	</Operation>

</Patch>
