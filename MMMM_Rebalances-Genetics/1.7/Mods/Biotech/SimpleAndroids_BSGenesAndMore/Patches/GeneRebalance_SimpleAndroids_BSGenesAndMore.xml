	<Operation Class="PatchOperationConditional">
		<xpath>Defs/XenotypeDef[defName="BS_NanomachineVampire"]/genes/li[text()="VU_GreaterHemogenDrain"]</xpath>
		<match Class="PatchOperationConditional">
			<xpath>Defs/XenotypeDef[defName="BS_NanomachineVampire"]/genes/li[text()="HemogenDrain"]</xpath>
