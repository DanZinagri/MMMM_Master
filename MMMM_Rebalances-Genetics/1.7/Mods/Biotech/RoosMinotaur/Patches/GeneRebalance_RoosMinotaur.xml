	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="RBM_EstrousCycle"]/biostatMet</xpath>
		<value>
			<biostatMet>1</biostatMet>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="RBM_RuminantStomach"]/biostatMet</xpath>
		<value>
			<biostatMet>-1</biostatMet>
		</value>
	</Operation>

</Patch>
