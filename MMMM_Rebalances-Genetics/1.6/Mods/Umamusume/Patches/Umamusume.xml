<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Umamusume rebalance: the Umamusume gene (JTC_Umamiscstuff) packs size, carrying, melee, healing and
		fertility into one gene. Its slower healing (x0.75) moves to vanilla's slow wound healing gene (x0.5, +2 metabolism).
		Size and carrying move out in the Big and Small and Alpha Genes subfolders, each only when that mod supplies the
		replacement gene, so nothing is lost without it.
		Verified 2026-11-24 against Umamusume: Rim Derby (3552197538, Uma_Biotech/1.6/Defs/UmaXenotype.xml; it has no 1.7 folder and loads 1.6 on 1.7).
	-->

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/GeneDef[defName="JTC_Umamiscstuff"]/statFactors/InjuryHealingFactor</xpath>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/XenotypeDef[defName="JTCUmamusume"][not(genes/li[text()="WoundHealing_Slow"])]/genes</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/XenotypeDef[defName="JTCUmamusume"][not(genes/li[text()="WoundHealing_Slow"])]/genes</xpath>
			<value>
				<li>WoundHealing_Slow</li>
			</value>
		</match>
	</Operation>

</Patch>
