<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Umamusume + Alpha Genes: the Umamusume gene's x1.2 carrying capacity and mass carry are removed and the
		xenotype gets pack mule instead (x1.5 both, -1 metabolism). Rowdy (+1 metabolism) is added as a metabolism offset.
		Verified 2026-11-24 against Umamusume: Rim Derby (3552197538, Uma_Biotech/1.6/Defs/UmaXenotype.xml; it has no 1.7 folder and loads 1.6 on 1.7).
	-->

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/GeneDef[defName="JTC_Umamiscstuff"]/statFactors/CarryingCapacity</xpath>
	</Operation>
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/GeneDef[defName="JTC_Umamiscstuff"]/statFactors/VEF_MassCarryCapacity</xpath>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/XenotypeDef[defName="JTCUmamusume"][not(genes/li[text()="AG_PackMule"])]/genes</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/XenotypeDef[defName="JTCUmamusume"][not(genes/li[text()="AG_PackMule"])]/genes</xpath>
			<value>
				<li>AG_PackMule</li>
			</value>
		</match>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/XenotypeDef[defName="JTCUmamusume"][not(genes/li[text()="AG_Rowdy"])]/genes</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/XenotypeDef[defName="JTCUmamusume"][not(genes/li[text()="AG_Rowdy"])]/genes</xpath>
			<value>
				<li>AG_Rowdy</li>
			</value>
		</match>
	</Operation>

</Patch>
