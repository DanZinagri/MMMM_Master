<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Moved here from the gene rebalance file (1.6/Mods/Biotech/Patches/GeneRebalance.xml).
		This folder loads only when Ludeon.RimWorld.Biotech is active and RedMattis.VanillaGenesRebalanced is NOT active (see loadFolders.xml). The same condition used to be a
		PatchOperationFindMod on the mod's display name; the load-folder gate uses its packageId instead.
	-->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="WoundHealing_Slow"]/biostatMet</xpath>
		<value>
			<biostatMet>3</biostatMet>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="MoveSpeed_Slow"]/statOffsets/MoveSpeed</xpath>
		<value>
			<MoveSpeed>-0.4</MoveSpeed>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="MoveSpeed_Quick"]/statOffsets/MoveSpeed</xpath>
		<value>
			<MoveSpeed>0.4</MoveSpeed>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="MoveSpeed_VeryQuick"]/statOffsets/MoveSpeed</xpath>
		<value>
			<MoveSpeed>0.7</MoveSpeed>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="NakedSpeed"]/conditionalStatAffecters</xpath>
		<value>
			<conditionalStatAffecters>
				<li Class="ConditionalStatAffecter_Clothed">
					<statOffsets>
						<MoveSpeed>-0.4</MoveSpeed>
					</statOffsets>
				</li>
				<li Class="ConditionalStatAffecter_Unclothed">
					<statOffsets>
						<MoveSpeed>0.8</MoveSpeed>
					</statOffsets>
				</li>
			</conditionalStatAffecters>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneTemplateDef[defName="AddictionResistant"]/biostatMet</xpath>
		<value>
			<biostatMet>-1</biostatMet>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneTemplateDef[defName="AddictionResistant"]/chemicalBiostatOverrides</xpath>
		<value>
			<chemicalBiostatOverrides>
				<li>
					<chemical>Alcohol</chemical>
					<biostatMet>0</biostatMet>
				</li>
				<li>
					<chemical>Smokeleaf</chemical>
					<biostatMet>0</biostatMet>
				</li>
			</chemicalBiostatOverrides>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneTemplateDef[defName="AddictionImmune"]/biostatMet</xpath>
		<value>
			<biostatMet>-2</biostatMet>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneTemplateDef[defName="AddictionImmune"]/chemicalBiostatOverrides</xpath>
		<value>
			<chemicalBiostatOverrides>
				<li>
					<chemical>Alcohol</chemical>
					<biostatMet>-1</biostatMet>
				</li>
				<li>
					<chemical>Smokeleaf</chemical>
					<biostatMet>-1</biostatMet>
				</li>
			</chemicalBiostatOverrides>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="AnimalWarcall"]/biostatMet</xpath>
		<value>
			<biostatMet>-2</biostatMet>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/AbilityDef[defName="FoamSpray"]/charges</xpath>
		<value>
			<charges>9</charges>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Proj_Acid"]/projectile/damageAmountBase</xpath>
		<value>
			<damageAmountBase>60</damageAmountBase>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/AbilityDef[defName="FireSpew"]/cooldownTicksRange</xpath>
		<value>
			<cooldownTicksRange>30000</cooldownTicksRange>
		</value>
	</Operation>

</Patch>
