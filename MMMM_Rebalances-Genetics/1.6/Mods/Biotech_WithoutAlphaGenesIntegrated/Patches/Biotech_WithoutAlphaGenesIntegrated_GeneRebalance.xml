<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Moved here from the gene rebalance file (1.6/Mods/Biotech/Patches/GeneRebalance.xml).
		This folder loads only when Ludeon.RimWorld.Biotech is active and kupa.AlphaGenesIntegrated is NOT active (see loadFolders.xml). The same condition used to be a
		PatchOperationFindMod on the mod's display name; the load-folder gate uses its packageId instead.
	-->

	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationSequence" MayRequire="sarg.alphagenes">
				<operations>
					<li Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationAdd">
								<xpath>Defs/XenotypeDef[defName="Highmate"]/genes</xpath>
								<value>
									<li>AG_NoRaidPresence</li>
								</value>
							</li>
						</operations>
					</li>
				</operations>
			</li>
		</operations>
	</Operation>

</Patch>
