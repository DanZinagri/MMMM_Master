		<xpath>Defs/GeneDef[defName="VRE_ChestburstPregnancy"]/biostatMet</xpath>
		<value>
			<biostatMet>0</biostatMet>
		</value>
	</Operation>
	<Operation Class="PatchOperationRemove">
