	</Operation>
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/VanillaRacesExpandedInsector.GenelineGeneDef[defName="VRE_InsectWings"]/exclusionTags/li[text()="InsectorMovement"]</xpath>
	</Operation>

</Patch>
