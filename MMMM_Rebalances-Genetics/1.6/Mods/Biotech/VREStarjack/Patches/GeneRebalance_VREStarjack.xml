<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.6/Mods/Biotech/Patches/GeneRebalance.xml: the operations that also need Vanilla Races Expanded - Starjack. -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="VREStarjack_SpacejumpLegs"]/biostatMet</xpath>
		<value>
			<biostatMet>-1</biostatMet>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="VREStarjack_OxygenSensitivity_Mild"]/biostatMet</xpath>
		<value>
			<biostatMet>1</biostatMet>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="VREStarjack_OxygenSensitivity_Intense"]/biostatMet</xpath>
		<value>
			<biostatMet>2</biostatMet>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="VREStarjack_OxygenSensitivity_Extreme"]/biostatMet</xpath>
		<value>
			<biostatMet>3</biostatMet>
		</value>
	</Operation>

</Patch>
