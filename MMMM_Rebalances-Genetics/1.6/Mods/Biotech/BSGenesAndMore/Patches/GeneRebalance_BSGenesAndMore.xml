	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="BS_HeatGenerator"]/description</xpath>
		<value>
			<description>Carriers of this gene will heat up their environment. They are also fire-proof and tolerant to extremely high temperatures. While somewhat tolerate low ambient temperatures, they are highly vulnerable to frostbite. Somewhat affected by body size.</description>
		</value>
	</Operation>
