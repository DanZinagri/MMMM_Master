<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.6/Mods/Biotech/Patches/GeneRebalance.xml: the operations that also need Big and Small - Races. -->

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/XenotypeDef[defName="BS_GreatOgre"]/genes</xpath>
		<value>
			<li>MeleeDamage_Strong</li>
			<li>Unstoppable</li>
			<li>VerySleepy</li>
			<li>BS_SlowBleeding</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/XenotypeDef[defName="BS_GreatOgre"]/genes/li[text()="Sleepy"]</xpath>
	</Operation>

</Patch>
