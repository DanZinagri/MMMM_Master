<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.6/Patches/OtherRebalance.xml: the operations that also need Vanilla Factions Expanded - Insectoids 2. -->

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="VFEI2_InsectJellyWall"]/building/alwaysDeconstructible</xpath>
		<nomatch Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="VFEI2_InsectJellyWall"]/killedLeavings/InsectJelly</xpath>
			<value>
				<InsectJelly>1</InsectJelly>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="VFEI2_InsectJellyWall"]/building/alwaysDeconstructible</xpath>
		<nomatch Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="VFEI2_RoyalJellyWall"]/killedLeavings/InsectJelly</xpath>
			<value>
				<VFEI2_RoyalInsectJelly>1</VFEI2_RoyalInsectJelly>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="VFEI2_InsectJellyWall"]/building/alwaysDeconstructible</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="VFEI2_InsectJellyWall" or defName="VFEI2_RoyalJellyWall"]/building</xpath>
			<value>
				<alwaysDeconstructible>true</alwaysDeconstructible>
				<deconstructible>true</deconstructible>
			</value>
		</nomatch>
	</Operation>

</Patch>
