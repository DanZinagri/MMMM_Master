<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Too Many Mods' other rebalance: assorted buildings, items, pawn kinds and factions. Moved whole from the core root file AA1D2_OtherRebalance.xml, where it sat behind the
		TMM_OtherRebalances setting (default on); installing this mod is the opt-in now.
		Each block sits in a load folder gated on the mods it touches (see loadFolders.xml); mods with no known packageId keep a name FindMod per operation. Checked with analysis/patch_sim.py against the installed mods:
		every op whose mods are installed applies. Blocks for mods not installed here are unchecked.
		Dropped two ops on VFEE_Deserter_* pawn kinds: no installed mod defines them (not VFE Empire, VFE Deserters or VPE),
		so they failed in Too Many Mods too. The PsychicAmplifier contraband op targets an extension VFE Deserters adds by patch.
	-->
	<Operation Class="PatchOperationAttributeAdd">
		<xpath>Defs/TraderKindDef[defName="Base_Outlander_Standard"]</xpath>
		<attribute>Name</attribute>
		<value>OutlanderBaseTrader</value>
	</Operation>
	<Operation Class="PatchOperationAttributeAdd">
		<xpath>Defs/TraderKindDef[defName="VFEM2_MerchantGuildTrader"]</xpath>
		<attribute>ParentName</attribute>
		<value>OutlanderBaseTrader</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/TraderKindDef[defName="VFEM2_MerchantGuildTrader"]/stockGenerators</xpath>
		<value>
			<stockGenerators>
				<li Class="StockGenerator_SingleDef">
					<thingDef>MedicineHerbal</thingDef>
					<countRange>30~60</countRange>
				</li>
				<li Class="StockGenerator_SingleDef">
					<thingDef>Pemmican</thingDef>
					<countRange>700~950</countRange>
				</li>
				<li Class="StockGenerator_BuyTradeTag">
					<tag>Mechanitor</tag>
				</li>
				<li Class="StockGenerator_BuyTradeTag">
					<tag>HighTechArmor</tag>
				</li>
			</stockGenerators>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VFEM2_2x1CastleDoor" or defName="VFEM2_2x1CastleGate"]/statBases/MaxHitPoints</xpath>
		<value>
			<!-- original: 800 -->
			<MaxHitPoints>300</MaxHitPoints>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VFEM2_3x1CastleDoor" or defName="VFEM2_3x1CastleGate"]/statBases/MaxHitPoints</xpath>
		<value>
			<!-- original: 1200 -->
			<MaxHitPoints>450</MaxHitPoints>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VFEM2_4x1CastleDoor" or defName="VFEM2_4x1CastleGate"]/statBases/MaxHitPoints</xpath>
		<value>
			<!-- original: 1600 -->
			<MaxHitPoints>600</MaxHitPoints>
		</value>
	</Operation>
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/HediffDef[defName="VFEM2_StrengthDraught"]/stages/li[label="potent"]/statFactors/IncomingDamageFactor</xpath>
	</Operation>

</Patch>
