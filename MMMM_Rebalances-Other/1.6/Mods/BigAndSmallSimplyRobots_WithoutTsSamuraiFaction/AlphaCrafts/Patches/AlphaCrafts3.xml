<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Moved here from 1.6/Mods/BigAndSmallSimplyRobots/Patches/BigAndSmallSimplyRobots.xml.
		This folder loads only when RedMattis.BigSmall.SimpleAndroids is active and Trickity.Samurai.Faction is NOT active (see loadFolders.xml). The same condition used to be a
		PatchOperationFindMod on the mod's display name; the load-folder gate uses its packageId instead.
	-->

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[@Name="BS_CommandoBotThingBase" or @Name="BS_TVAndroidThingBase"]/race/willNeverEat</xpath>
		<value>
			<li>AC_Sake</li>
		</value>
	</Operation>

</Patch>
