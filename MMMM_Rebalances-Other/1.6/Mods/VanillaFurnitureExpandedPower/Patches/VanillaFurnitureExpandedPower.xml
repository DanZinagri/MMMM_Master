<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		The archotech violence generator and both vanometric power cells count as archotech tech level.
		This folder only loads when Vanilla Furniture Expanded - Power is active (see loadFolders.xml).
		Verified against VFE - Power 1.6: none of the three defs has a techLevel, so these set one.
		Side effect worth knowing: with Vanilla Psycasts Expanded, archotech-tech-level buildings can serve as an
		Archotechnology meditation focus, which is why the original author set these.
	-->
	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationConditional">
				<xpath>Defs/ThingDef[defName="VPE_ArchotechViolenceGenerator"]/techLevel</xpath>
				<nomatch Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="VPE_ArchotechViolenceGenerator"]</xpath>
					<value>
						<techLevel>Archotech</techLevel>
					</value>
				</nomatch>
			</li>
			<li Class="PatchOperationConditional">
				<xpath>Defs/ThingDef[defName="VFE_SmallVanometricPowerCell"]/techLevel</xpath>
				<nomatch Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="VFE_SmallVanometricPowerCell"]</xpath>
					<value>
						<techLevel>Archotech</techLevel>
					</value>
				</nomatch>
			</li>
			<li Class="PatchOperationConditional">
				<xpath>Defs/ThingDef[defName="VFE_LargeVanometricPowerCell"]/techLevel</xpath>
				<nomatch Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="VFE_LargeVanometricPowerCell"]</xpath>
					<value>
						<techLevel>Archotech</techLevel>
					</value>
				</nomatch>
			</li>
		</operations>
	</Operation>

</Patch>
