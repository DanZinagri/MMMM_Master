<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Moved here from the root file 1.6/Patches/OtherRebalance.xml.
		This folder loads only when det.aprilfools.archocubes is active (see loadFolders.xml). The same condition used to be a
		PatchOperationFindMod on the mod's display name; the load-folder gate uses its packageId instead.
	-->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="ArchovectorBase"]/butcherProducts/DV_Archocompound</xpath>
		<value>
			<DV_Archocompound>10</DV_Archocompound>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="ArchofractoidBase"]/butcherProducts/DV_Archocompound</xpath>
		<value>
			<DV_Archocompound>5</DV_Archocompound>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="ArchotetralBase"]/butcherProducts/DV_Archocompound</xpath>
		<value>
			<DV_Archocompound>15</DV_Archocompound>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="ArchoCuboidBase"]/butcherProducts/DV_Archocompound</xpath>
		<value>
			<DV_Archocompound>30</DV_Archocompound>
		</value>
	</Operation>
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[@Name="ArchoCuboidBase"]/butcherProducts/BroadshieldCore</xpath>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="DV_Archocompound"]/statBases/MarketValue</xpath>
		<value>
			<MarketValue>5</MarketValue>
		</value>
	</Operation>

</Patch>
