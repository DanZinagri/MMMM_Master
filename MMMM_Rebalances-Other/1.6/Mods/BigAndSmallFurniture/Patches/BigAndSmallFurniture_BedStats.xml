		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="BS_BigHospitalBed"]/statBases</xpath>
			<value><BedRestEffectiveness>1</BedRestEffectiveness></value>
		</nomatch>
	</Operation>

	<!-- big royal bed = vanilla royal bed -->
