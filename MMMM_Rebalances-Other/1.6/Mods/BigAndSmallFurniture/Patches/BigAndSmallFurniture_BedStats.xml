		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="BS_BigRoyalBed"]/statBases</xpath>
			<value><BedRestEffectiveness>1.05</BedRestEffectiveness></value>
		</nomatch>
	</Operation>

	<!-- big bedroll = vanilla bedroll (upstream inherits normal-bed comfort and immunity) -->
	<Operation Class="PatchOperationConditional"> <!-- BedRestEffectiveness: upstream 1 -->
		<xpath>Defs/ThingDef[defName="BS_BigBedroll"]/statBases/BedRestEffectiveness</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="BS_BigBedroll"]/statBases/BedRestEffectiveness</xpath>
			<value><BedRestEffectiveness>0.95</BedRestEffectiveness></value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="BS_BigBedroll"]/statBases</xpath>
			<value><BedRestEffectiveness>0.95</BedRestEffectiveness></value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional"> <!-- Comfort: upstream 0.75 inherited -->
		<xpath>Defs/ThingDef[defName="BS_BigBedroll"]/statBases/Comfort</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="BS_BigBedroll"]/statBases/Comfort</xpath>
			<value><Comfort>0.68</Comfort></value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="BS_BigBedroll"]/statBases</xpath>
			<value><Comfort>0.68</Comfort></value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional"> <!-- ImmunityGainSpeedFactor: upstream 1.07 inherited -->
