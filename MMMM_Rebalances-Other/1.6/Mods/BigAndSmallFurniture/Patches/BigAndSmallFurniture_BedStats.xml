		<xpath>Defs/ThingDef[defName="BS_BigHospitalBed"]/statBases/BedRestEffectiveness</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="BS_BigHospitalBed"]/statBases/BedRestEffectiveness</xpath>
