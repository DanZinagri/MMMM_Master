<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Big and Small Furniture's giant beds rest/sleep better than the beds they are scaled up from.
		This sets each one back to its original's numbers (vanilla Core/Royalty values).
		The giant primitive beds and the mega universal bed have no normal-size original and are left alone.
		Each stat is replaced if the def sets it and added if it only inherits it.
	-->

	<!-- big bed = vanilla bed -->
	<Operation Class="PatchOperationConditional"> <!-- BedRestEffectiveness: upstream 1.05 -->
		<xpath>Defs/ThingDef[defName="BS_BigBed"]/statBases/BedRestEffectiveness</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="BS_BigBed"]/statBases/BedRestEffectiveness</xpath>
			<value><BedRestEffectiveness>1</BedRestEffectiveness></value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="BS_BigBed"]/statBases</xpath>
			<value><BedRestEffectiveness>1</BedRestEffectiveness></value>
		</nomatch>
	</Operation>

	<!-- big double bed = vanilla double bed -->
	<Operation Class="PatchOperationConditional"> <!-- BedRestEffectiveness: upstream 1.05 -->
		<xpath>Defs/ThingDef[defName="BS_BigDoubleBed"]/statBases/BedRestEffectiveness</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="BS_BigDoubleBed"]/statBases/BedRestEffectiveness</xpath>
			<value><BedRestEffectiveness>1</BedRestEffectiveness></value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="BS_BigDoubleBed"]/statBases</xpath>
			<value><BedRestEffectiveness>1</BedRestEffectiveness></value>
		</nomatch>
	</Operation>

	<!-- big hospital bed = vanilla hospital bed -->
