		<xpath>Defs/ThingDef[defName="BS_BigDoubleBedroll"]/statBases/Comfort</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="BS_BigDoubleBedroll"]/statBases/Comfort</xpath>
