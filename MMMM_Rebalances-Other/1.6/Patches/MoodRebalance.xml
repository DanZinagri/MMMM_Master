						<operations>
							<li Class="PatchOperationReplace">
								<xpath>/Defs/ThoughtDef[defName="PsychicHarmonization"]/stages/li[label="psychic harmony: {HARMONIZER_labelShort}"]/baseMoodEffect</xpath>
