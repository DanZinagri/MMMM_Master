<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Too Many Mods' mood rebalance: thought and mood values. Moved whole from the core root file AA3C_MoodRebalance.xml, where it sat behind the
		TMM_MoodRebalances setting (default on); installing this mod is the opt-in now.
		Each block is gated on the mods it touches (MayRequire / MayRequireAnyOf on an <li>); mods with no known packageId keep a
		name FindMod; blocks that depend on another mod being present or absent now live in gated load folders (loadFolders.xml). Checked with analysis/patch_sim.py against the installed mods:
		every op whose mods are installed applies. Blocks for mods not installed here are unchecked.
	-->
	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationSequence" MayRequire="sarg.alphabiomes">
				<operations>
					<li Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationReplace">
								<xpath>/Defs/TerrainDef[defName="AB_WebbedMarshyTerrain"]/statBases/Beauty</xpath>
								<value>
									<Beauty>-30</Beauty>
								</value>
							</li>
							<li Class="PatchOperationReplace">
								<xpath>/Defs/TerrainDef[defName="AB_WebbedMarshyTerrain"]/statBases/BeautyOutdoors</xpath>
								<value>
									<BeautyOutdoors>-30</BeautyOutdoors>
								</value>
							</li>
						</operations>
					</li>
				</operations>
			</li>
		</operations>
	</Operation>

	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationSequence" MayRequire="Ludeon.RimWorld.Anomaly">
				<operations>
					<li Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationReplace">
								<xpath>/Defs/HediffDef[defName="MindNumbSerum"]/stages/li/capMods</xpath>
								<value>
									<capMods>
										<li>
											<capacity>Consciousness</capacity>
											<setMax>0.9</setMax>
										</li>
									</capMods>
								</value>
							</li>
						</operations>
					</li>
				</operations>
			</li>
		</operations>
	</Operation>

	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThoughtDef[defName="PawnWithGoodOpinionDied"]/stages/li[label="my friend {0} died"]/baseMoodEffect</xpath>
				<value>
					<baseMoodEffect>-20</baseMoodEffect>
				</value>
			</li>
		</operations>
	</Operation>

	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationReplace">
				<xpath>/Defs/ThoughtDef[defName="MySonDied"]/stages/li[label="my son {0} died"]/baseMoodEffect</xpath>
