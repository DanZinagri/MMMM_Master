			<li Class="PatchOperationSequence" MayRequire="veterano.mythicages.megafaunabestiary">
				<operations>
					<li Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationReplace">
								<xpath>Defs/ThoughtDef[defName="MA_AteCookedPlastemmothMeat"]/stages/li/baseMoodEffect</xpath>
								<value>
									<baseMoodEffect>5</baseMoodEffect>
								</value>
							</li>
							<li Class="PatchOperationReplace">
								<xpath>Defs/ThoughtDef[defName="MA_AteCookedScarodonMeat" or defName="MA_AteCookedDunbearMeat"]/stages/li/baseMoodEffect</xpath>
								<value>
									<baseMoodEffect>4</baseMoodEffect>
								</value>
							</li>
							<li Class="PatchOperationReplace">
								<xpath>Defs/ThoughtDef[defName="MA_AteHippoMeatCooked" or defName="MA_AteRaptorkhanMeatCooked" or defName="MA_AteCookedWorhinMeat"]/stages/li/baseMoodEffect</xpath>
								<value>
									<baseMoodEffect>3</baseMoodEffect>
								</value>
							</li>
							<li Class="PatchOperationReplace">
								<xpath>Defs/ThoughtDef[defName="MA_AteCookedSivatheriumMeat"]/stages/li/baseMoodEffect</xpath>
								<value>
									<baseMoodEffect>2</baseMoodEffect>
