		<value>
			<thingDefCountRange>6~10</thingDefCountRange>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/TraderKindDef[defName="Orbital_PirateMerchant"]/stockGenerators/li[tradeTag="TechHediff"]/thingDefCountRange</xpath>
