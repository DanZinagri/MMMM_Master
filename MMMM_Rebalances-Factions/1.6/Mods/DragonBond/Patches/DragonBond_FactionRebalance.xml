<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Moved here from the root file 1.6/Patches/FactionRebalance.xml.
		This folder loads only when Crows.DragonBond is active (see loadFolders.xml). The same condition used to be a
		PatchOperationFindMod on the mod's display name; the load-folder gate uses its packageId instead.
	-->

	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationSequence">
				<operations>
					<li Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationReplace">
								<xpath>Defs/FactionDef[defName="Crows_VelosEnclave" or defName="Crows_AshenDominion"]/requiredCountAtGameStart</xpath>
								<value>
									<requiredCountAtGameStart>1</requiredCountAtGameStart>
								</value>
							</li>
							<li Class="PatchOperationReplace">
								<xpath>Defs/FactionDef[defName="Crows_VelosEnclave" or defName="Crows_AshenDominion"]/settlementGenerationWeight</xpath>
								<value>
									<settlementGenerationWeight>0.5</settlementGenerationWeight>
								</value>
							</li>
						</operations>
					</li>
				</operations>
			</li>
		</operations>
	</Operation>

</Patch>
