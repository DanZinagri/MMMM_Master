<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Moved here from 1.7/Mods/AlphaGenes/Patches/AlphaGenes.xml.
		This folder loads only when sarg.alphagenes is active and mytigio.harbingerkin is NOT active (see loadFolders.xml). The same condition used to be a
		PatchOperationFindMod on the mod's display name; the load-folder gate uses its packageId instead.
	-->

	<!--
		With VRE Phytokin and Anomaly, the Horax cult also fields Ocularkin (weight 0.2), creating its xenotype set if it has
		none. Skipped when HarbingerKin - Phytokin is installed, which handles the cult itself (MMMM_Integrations-Factions'
		HarbingerKin patch covers that case).
		Verified: vanilla's Horax cult has no Ocularkin entry.
	-->
	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationSequence" MayRequire="vanillaracesexpanded.phytokin,Ludeon.RimWorld.Anomaly">
				<operations>
					<li Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationConditional">
								<xpath>Defs/FactionDef[defName="HoraxCult"]/xenotypeSet</xpath>
								<match Class="PatchOperationAdd">
									<xpath>Defs/FactionDef[defName="HoraxCult"]/xenotypeSet/xenotypeChances</xpath>
									<value>
										<VRE_Ocularkin>0.2</VRE_Ocularkin>
									</value>
								</match>
								<nomatch Class="PatchOperationAdd">
									<xpath>Defs/FactionDef[defName="HoraxCult"]</xpath>
									<value>
										<xenotypeSet Inherit="False">
											<xenotypeChances>
												<VRE_Ocularkin>0.2</VRE_Ocularkin>
											</xenotypeChances>
										</xenotypeSet>
									</value>
								</nomatch>
							</li>
						</operations>
					</li>
				</operations>
			</li>
		</operations>
	</Operation>

</Patch>
