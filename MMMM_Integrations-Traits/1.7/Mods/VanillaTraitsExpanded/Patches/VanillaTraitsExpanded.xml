<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Vanilla Traits Expanded traits join other systems: vanilla and VSIE inspirations they should be barred from, and
		meditation focus types they should allow.
		This folder only loads when Vanilla Traits Expanded is active (see loadFolders.xml), so no FindMod check is needed
		for VTE itself; optional contributors are gated by subfolder or per list entry.
		Verified against VTE 1.6: none of these traits define disallowedInspirations or allowedMeditationFocusTypes
		upstream, and the vanilla Chimera thought has no nullifyingTraits, so each whole element is added.
		Split by category into the MMMM Integrations sub-mods: this copy holds only the Traits ops (traits).
	-->
	<!-- Inspirations these traits should never get -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/TraitDef[defName="VTE_Prude"]/degreeDatas/li</xpath>
		<value>
			<disallowedInspirations>
				<li MayRequire="VanillaExpanded.VanillaSocialInteractionsExpanded">VSIE_Flirting_Frenzy</li>
			</disallowedInspirations>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/TraitDef[defName="VTE_Technophobe"]/degreeDatas/li</xpath>
		<value>
			<disallowedInspirations>
				<li MayRequire="VanillaExpanded.VanillaSocialInteractionsExpanded">VSIE_Inspired_Research</li>
			</disallowedInspirations>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/TraitDef[defName="VTE_Coward"]/degreeDatas/li</xpath>
		<value>
			<disallowedInspirations>
				<li>Frenzy_Shoot</li>
				<li MayRequire="VanillaExpanded.VanillaSocialInteractionsExpanded">VSIE_Melee_Frenzy</li>
			</disallowedInspirations>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/TraitDef[defName="VTE_AnimalHater"]/degreeDatas/li</xpath>
		<value>
			<disallowedInspirations>
				<li>Inspired_Taming</li>
			</disallowedInspirations>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/TraitDef[defName="VTE_Anxious"]/degreeDatas/li</xpath>
		<value>
			<disallowedInspirations>
				<li>Inspired_Recruitment</li>
				<li MayRequire="VanillaExpanded.VanillaSocialInteractionsExpanded">VSIE_Party_Frenzy</li>
				<li MayRequire="VanillaExpanded.VanillaSocialInteractionsExpanded">VSIE_Flirting_Frenzy</li>
			</disallowedInspirations>
		</value>
	</Operation>
	<!-- Meditation focus types these traits should allow -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/TraitDef[defName="VTE_Ecologist" or defName="VTE_Dunce" or defName="VTE_ChildOfMountain"]/degreeDatas/li</xpath>
		<value>
			<allowedMeditationFocusTypes>
				<li>Natural</li>
			</allowedMeditationFocusTypes>
		</value>
	</Operation>

</Patch>
