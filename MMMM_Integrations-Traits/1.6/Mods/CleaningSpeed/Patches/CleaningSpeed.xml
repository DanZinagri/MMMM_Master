<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Cleaning Speed's trait values move onto Vanilla Traits Expanded's Neat and Slob: +50% and -50% cleaning speed.
		MMMM Convergence - Other retires Cleaning Speed's own Fastidious/Slovenly trait under the same gate.
		This folder only loads when both mods are active (see loadFolders.xml).
		Verified against VTE 1.6: neither trait defines statOffsets upstream, so the whole element is added.
	-->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/TraitDef[defName="VTE_Neat"]/degreeDatas/li</xpath>
		<value>
			<statOffsets>
				<CleaningSpeed>0.5</CleaningSpeed>
			</statOffsets>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/TraitDef[defName="VTE_Slob"]/degreeDatas/li</xpath>
		<value>
			<statOffsets>
				<CleaningSpeed>-0.5</CleaningSpeed>
			</statOffsets>
		</value>
	</Operation>

</Patch>
