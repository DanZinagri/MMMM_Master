<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Vanilla Fishing Expanded's Fisherman trait joins other mods' systems:
		- The Angler meme (VIE - Memes and Structures) agrees with it.
		- With Goji's Fantasy Race: Merren, a fisherman can meditate on water.
		This folder only loads when Vanilla Fishing Expanded is active (see loadFolders.xml); the contributing mods are
		gated per operation.
		Verified against VIE 1.6 and VFiE 1.6 (both the Odyssey and non-Odyssey variants): VME_Angler has no
		agreeableTraits and VCEF_Fisherman has no allowedMeditationFocusTypes, so each whole element is added.
		Split by category into the MMMM Integrations sub-mods: this copy holds only the Traits ops (traits).
	-->
	<Operation Class="PatchOperationSequence">
		<operations>
			<!--
				Kept as a FindMod check rather than MayRequire because Goji's Fantasy Race: Merren is not installed
				here, so its packageId could not be verified. Same treatment as the Child of the sea patch in
				Mods/VanillaTraitsExpanded.
			-->
			<li Class="PatchOperationFindMod">
				<mods>
					<li>Goji's Fantasy Race: Merren</li>
				</mods>
				<match Class="PatchOperationAdd">
					<xpath>Defs/TraitDef[defName="VCEF_Fisherman"]/degreeDatas/li</xpath>
					<value>
						<allowedMeditationFocusTypes>
							<li>Stagz_Water</li>
						</allowedMeditationFocusTypes>
					</value>
				</match>
			</li>
		</operations>
	</Operation>

</Patch>
