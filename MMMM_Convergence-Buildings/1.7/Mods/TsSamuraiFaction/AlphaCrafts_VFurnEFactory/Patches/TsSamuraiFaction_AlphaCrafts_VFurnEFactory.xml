<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.7/Mods/TsSamuraiFaction/Patches/TsSamuraiFaction.xml: the operations that also need Alpha Crafts and Vanilla Furniture Expanded - Factory. -->

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/PipeSystem.ProcessDef[defName="VFEFactory_MakeSakeFromRice"]/results/li/thing[text()="AC_Sake"]</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/PipeSystem.ProcessDef[defName="VFEFactory_MakeSakeFromRice"]/results/li/thing[text()="AC_Sake"]</xpath>
			<value>
				<thing>TSF_Sake</thing>
			</value>
		</match>
	</Operation>

</Patch>
