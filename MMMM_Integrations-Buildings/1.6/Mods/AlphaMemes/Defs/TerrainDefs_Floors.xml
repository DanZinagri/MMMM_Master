<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!--
		Alpha Memes' stone tile styles (Jewish, Jewish fine, Kemetic, Kemetic fine, Steampunk, Ocular) for two more stones:
		Gulden Biome (Continued)'s aurelian stone and Odyssey's vacstone, six floors each. Each floor carries a def-level
		MayRequire on the mod that supplies its stone; this folder only loads when Alpha Memes is active (see loadFolders.xml).
		The original injected these with PatchOperationAdd on Defs inside name FindMods.
		Verified: all six Alpha Memes parent styles exist, Alpha Memes itself makes no aurelian or vacstone tiles, and
		Odyssey's BlocksVacstone exists. Flooring Floors adds its own floor styles for both stones, not Alpha Memes' ones, so
		there is no overlap. Gulden Biome is not installed here, so the aurelian stone blocks are unverified.
	-->

	<TerrainDef ParentName="AM_JewishTileStoneBase" MayRequire="pphhyy.guldennew">
		<defName>TMM_AM_JewishTileAurelianStone</defName>
		<label>jewish aurelian stone tile</label>
		<color>(174,154,118)</color>
		<costList>
			<BlocksAurelianStone>4</BlocksAurelianStone>
		</costList>
		<statBases>
			<Beauty>4</Beauty>
		</statBases>
	</TerrainDef>

	<TerrainDef ParentName="AM_JewishFineStoneTiles" MayRequire="pphhyy.guldennew">
		<defName>TMM_AM_JewishFineTileAurelianStone</defName>
		<label>jewish fine aurelian stone tile</label>
		<costList>
			<BlocksAurelianStone>20</BlocksAurelianStone>
		</costList>
		<statBases>
			<Beauty>6</Beauty>
		</statBases>
	</TerrainDef>

