<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.7/Mods/VanillaPsycastsExpanded/Patches/VanillaPsycastsExpanded.xml: the operations that also need Vanilla Furniture Expanded - Power. -->

	<!-- VFE Power vanometric cells and archotech violence generator -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="VFE_SmallVanometricPowerCell"]/statBases</xpath>
		<value>
			<MeditationFocusStrength>0.24</MeditationFocusStrength>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="VFE_LargeVanometricPowerCell"]/statBases</xpath>
		<value>
			<MeditationFocusStrength>0.42</MeditationFocusStrength>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="VPE_ArchotechViolenceGenerator"]/statBases</xpath>
		<value>
			<MeditationFocusStrength>0.48</MeditationFocusStrength>
		</value>
	</Operation>

</Patch>
