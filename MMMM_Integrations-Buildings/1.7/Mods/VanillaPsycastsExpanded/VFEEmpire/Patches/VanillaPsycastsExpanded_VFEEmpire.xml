<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.7/Mods/VanillaPsycastsExpanded/Patches/VanillaPsycastsExpanded.xml: the operations that also need Vanilla Factions Expanded - Empire. -->

	<!-- VFE Empire grand table and royal stool (Wealth focus) -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="VFEE_GrandTable" or defName="VFEE_RoyalStool"]</xpath>
		<value>
			<comps>
				<li Class="CompProperties_MeditationFocus">
					<statDef>MeditationFocusStrength</statDef>
					<focusTypes>
						<li>VPE_Wealth</li>
					</focusTypes>
					<offsets>
						<li Class="FocusStrengthOffset_BuildingDefs">
							<defs>
								<RoyalBed>0.03</RoyalBed>
								<Bed_Kingsize MayRequire="VanillaExpanded.VFECore">0.03</Bed_Kingsize>
								<Table_RoyalEndTable MayRequire="VanillaExpanded.VFECore">0.02</Table_RoyalEndTable>
								<Table_RoyalDresser MayRequire="VanillaExpanded.VFECore">0.03</Table_RoyalDresser>
								<Seat_RoyalChair MayRequire="VanillaExpanded.VFECore">0.02</Seat_RoyalChair>
								<Seat_RoyalArmchair MayRequire="VanillaExpanded.VFECore">0.03</Seat_RoyalArmchair>
								<Table_Royal1x1c MayRequire="VanillaExpanded.VFECore">0.02</Table_Royal1x1c>
								<Table_Royal2x2c MayRequire="VanillaExpanded.VFECore">0.02</Table_Royal2x2c>
								<Table_Royal1x2c MayRequire="VanillaExpanded.VFECore">0.02</Table_Royal1x2c>
								<Table_Royal3x3c MayRequire="VanillaExpanded.VFECore">0.03</Table_Royal3x3c>
								<Table_Royal2x4c MayRequire="VanillaExpanded.VFECore">0.03</Table_Royal2x4c>
								<VFEE_GrandTable MayRequire="OskarPotocki.VFE.Empire">0.04</VFEE_GrandTable>
								<VFEE_RoyalStool MayRequire="OskarPotocki.VFE.Empire">0.02</VFEE_RoyalStool>
							</defs>
							<radius>8.9</radius>
							<maxBuildings>6</maxBuildings>
							<explanationKey>MeditationFocusPerWealthy</explanationKey>
							<explanationKeyAbstract>MeditationFocusPerWealthyAbstract</explanationKeyAbstract>
						</li>
					</offsets>
				</li>
			</comps>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="VFEE_GrandTable"]/statBases</xpath>
		<value>
			<MeditationFocusStrength>0.20</MeditationFocusStrength>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="VFEE_RoyalStool"]/statBases</xpath>
		<value>
			<MeditationFocusStrength>0.11</MeditationFocusStrength>
		</value>
	</Operation>

</Patch>
