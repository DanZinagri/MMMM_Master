			<!-- Alpha Biomes derelict archotech structures (its Odyssey content) -->
			<li Class="PatchOperationSequence" MayRequire="sarg.alphabiomes,Ludeon.RimWorld.Odyssey">
				<operations>
					<li Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="AB_DerelictArchotechTower" or defName="AB_DerelictMajorArchotechStructure" or defName="AB_DerelictArchonexusCore"]/statBases</xpath>
