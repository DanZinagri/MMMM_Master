<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Vanilla Psycasts Expanded meditation focus on other mods' buildings: archotech structures and vanometric power
		sources give psyfocus strength, and royal furniture from vanilla, VFE Furniture and VFE Empire becomes a Wealth
		focus source that grows stronger with more royal furniture nearby.
		This folder only loads when VPE is active (see loadFolders.xml). Each partner mod's part is gated on its packageId;
		each part sits in a subfolder gated on it in loadFolders.xml.

		Changes from the original, which gated each part with a PatchOperationFindMod on the mod's display name:
		- The VFE Empire op targeted `efName="VFEE_RoyalStool"`, a typo, so the royal stool never got its focus comp even
		  though it had the focus stat and was listed in every offset table. Corrected to defName.
		- The Alpha Biomes derelict structures already have a <statBases> node, so adding a second one logged a
		  duplicate-node error and the later node replaced their stats. The op now adds into the existing <statBases>.
		All 27 target defs were checked against the current VPE, VFE Furniture, VFE Empire, VFE Power, VFE Art, VGE,
		Alpha Biomes and vanilla 1.6 defs; no installed mod already makes any of them a meditation focus source.
		Split by category into the MMMM Integrations sub-mods: this copy holds only the Buildings ops (buildings, furniture, floors, recipes and production).
	-->
	<!-- Vanilla and Royalty: royal bed (Wealth focus) and vanometric power cell -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RoyalBed"]/statBases</xpath>
		<value>
			<MeditationFocusStrength>0.16</MeditationFocusStrength>
		</value>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="RoyalBed"]/comps</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="RoyalBed"]/comps</xpath>
			<value>
				<li Class="CompProperties_MeditationFocus">
					<statDef>MeditationFocusStrength</statDef>
					<focusTypes>
						<li>VPE_Wealth</li>
					</focusTypes>
					<offsets>
						<li Class="FocusStrengthOffset_BuildingDefs">
							<defs>
								<RoyalBed>0.03</RoyalBed>
								<Bed_Kingsize MayRequire="VanillaExpanded.VFECore">0.03</Bed_Kingsize>
								<Table_RoyalEndTable MayRequire="VanillaExpanded.VFECore">0.02</Table_RoyalEndTable>
								<Table_RoyalDresser MayRequire="VanillaExpanded.VFECore">0.03</Table_RoyalDresser>
								<Seat_RoyalChair MayRequire="VanillaExpanded.VFECore">0.02</Seat_RoyalChair>
								<Seat_RoyalArmchair MayRequire="VanillaExpanded.VFECore">0.03</Seat_RoyalArmchair>
								<Table_Royal1x1c MayRequire="VanillaExpanded.VFECore">0.02</Table_Royal1x1c>
								<Table_Royal2x2c MayRequire="VanillaExpanded.VFECore">0.02</Table_Royal2x2c>
								<Table_Royal1x2c MayRequire="VanillaExpanded.VFECore">0.02</Table_Royal1x2c>
								<Table_Royal3x3c MayRequire="VanillaExpanded.VFECore">0.03</Table_Royal3x3c>
								<Table_Royal2x4c MayRequire="VanillaExpanded.VFECore">0.03</Table_Royal2x4c>
								<VFEE_GrandTable MayRequire="OskarPotocki.VFE.Empire">0.04</VFEE_GrandTable>
								<VFEE_RoyalStool MayRequire="OskarPotocki.VFE.Empire">0.02</VFEE_RoyalStool>
							</defs>
							<radius>8.9</radius>
							<maxBuildings>6</maxBuildings>
							<explanationKey>MeditationFocusPerWealthy</explanationKey>
							<explanationKeyAbstract>MeditationFocusPerWealthyAbstract</explanationKeyAbstract>
						</li>
					</offsets>
				</li>
			</value>
		</match>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="RoyalBed"]/comps</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="RoyalBed"]</xpath>
			<value>
				<comps>
					<li Class="CompProperties_MeditationFocus">
						<statDef>MeditationFocusStrength</statDef>
						<focusTypes>
							<li>VPE_Wealth</li>
						</focusTypes>
						<offsets>
							<li Class="FocusStrengthOffset_BuildingDefs">
								<defs>
									<RoyalBed>0.03</RoyalBed>
									<Bed_Kingsize MayRequire="VanillaExpanded.VFECore">0.03</Bed_Kingsize>
									<Table_RoyalEndTable MayRequire="VanillaExpanded.VFECore">0.02</Table_RoyalEndTable>
									<Table_RoyalDresser MayRequire="VanillaExpanded.VFECore">0.03</Table_RoyalDresser>
									<Seat_RoyalChair MayRequire="VanillaExpanded.VFECore">0.02</Seat_RoyalChair>
									<Seat_RoyalArmchair MayRequire="VanillaExpanded.VFECore">0.03</Seat_RoyalArmchair>
									<Table_Royal1x1c MayRequire="VanillaExpanded.VFECore">0.02</Table_Royal1x1c>
									<Table_Royal2x2c MayRequire="VanillaExpanded.VFECore">0.02</Table_Royal2x2c>
									<Table_Royal1x2c MayRequire="VanillaExpanded.VFECore">0.02</Table_Royal1x2c>
									<Table_Royal3x3c MayRequire="VanillaExpanded.VFECore">0.03</Table_Royal3x3c>
									<Table_Royal2x4c MayRequire="VanillaExpanded.VFECore">0.03</Table_Royal2x4c>
									<VFEE_GrandTable MayRequire="OskarPotocki.VFE.Empire">0.04</VFEE_GrandTable>
									<VFEE_RoyalStool MayRequire="OskarPotocki.VFE.Empire">0.02</VFEE_RoyalStool>
								</defs>
								<radius>8.9</radius>
								<maxBuildings>6</maxBuildings>
								<explanationKey>MeditationFocusPerWealthy</explanationKey>
								<explanationKeyAbstract>MeditationFocusPerWealthyAbstract</explanationKeyAbstract>
							</li>
						</offsets>
					</li>
				</comps>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="VanometricPowerCell"]/statBases</xpath>
		<value>
			<MeditationFocusStrength>0.36</MeditationFocusStrength>
		</value>
	</Operation>

</Patch>
