<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.7/Mods/AlphaCrafts/Patches/AlphaCrafts.xml: the operations that also need Dark Ages : Beasts and Monsters. -->

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/RecipeDef[defName="AC_GrindHorns"]/ingredients/li/filter/thingDefs</xpath>
		<value>
			<li>DA_DrogTusk</li>
			<li>DA_GoldiloxHorn</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/RecipeDef[defName="AC_GrindHorns"]/fixedIngredientFilter/thingDefs</xpath>
		<value>
			<li>DA_DrogTusk</li>
			<li>DA_GoldiloxHorn</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/RecipeDef[defName="AC_GrindHorns"]/defaultIngredientFilter/thingDefs</xpath>
		<value>
			<li>DA_DrogTusk</li>
			<li>DA_GoldiloxHorn</li>
		</value>
	</Operation>

</Patch>
