<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.7/Mods/VanillaPlantsExpandedMushrooms/Patches/VanillaPlantsExpandedMushrooms.xml: the operations that also need Vanilla Furniture Expanded. -->

	<!-- modded beds -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Bed_Kingsize"]/comps/li[@Class="CompProperties_AffectedByFacilities"]/linkableFacilities</xpath>
		<value>
			<li>VPE_Plant_Lullabloom</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[@Name="VFE_ChiseledBedBase" or @Name="VFE_SimpleBedBase" or @Name="VFE_ErgonomicBedBase"]/comps/li[@Class="CompProperties_AffectedByFacilities"]/linkableFacilities</xpath>
		<value>
			<li>VPE_Plant_Lullabloom</li>
		</value>
	</Operation>

</Patch>
