<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.6/Patches/AgreeingMemes.xml: the operations that also need GoGaTio.LostFactoryMechanoids and Ideology. -->

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/MemeDef[defName="LFM_Mechanization"]/disagreeableTraits</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/MemeDef[defName="LFM_Mechanization"]/disagreeableTraits</xpath>
			<value>
				<li MayRequire="VanillaExpanded.VanillaTraitsExpanded">VTE_Technophobe</li>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/MemeDef[defName="LFM_Mechanization"]</xpath>
			<value>
				<disagreeableTraits>
					<li MayRequire="VanillaExpanded.VanillaTraitsExpanded">VTE_Technophobe</li>
				</disagreeableTraits>
			</value>
		</nomatch>
	</Operation>

</Patch>
