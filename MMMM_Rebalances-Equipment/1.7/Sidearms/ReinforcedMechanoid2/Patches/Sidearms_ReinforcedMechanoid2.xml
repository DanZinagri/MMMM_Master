<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.7/Patches/Sidearms.xml: the operations that also need Mlie.ReinforcedMechanoid2. -->

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="RM_Gun_ChargePistol"]/modExtensions/li[@Class="VEF.Things.ThingDefExtension"]/usableWithShields</xpath>
		<nomatch Class="PatchOperationAddModExtension">
			<xpath>Defs/ThingDef[defName="RM_Gun_ChargePistol"]</xpath>
			<value>
				<li Class="VEF.Things.ThingDefExtension">
					<usableWithShields>true</usableWithShields>
				</li>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="RM_Gun_ChargeLancePistol"]/modExtensions/li[@Class="VEF.Things.ThingDefExtension"]/usableWithShields</xpath>
		<nomatch Class="PatchOperationAddModExtension">
			<xpath>Defs/ThingDef[defName="RM_Gun_ChargeLancePistol"]</xpath>
			<value>
				<li Class="VEF.Things.ThingDefExtension">
					<usableWithShields>true</usableWithShields>
				</li>
			</value>
		</nomatch>
	</Operation>

</Patch>
