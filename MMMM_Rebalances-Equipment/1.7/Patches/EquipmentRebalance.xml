<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Too Many Mods' equipment rebalance: weapon, armour and apparel stats across many mods. Moved whole from the core root file AA1A_EquipmentRebalance.xml, where it sat behind the
		TMM_EquipmentRebalances setting (default on); installing this mod is the opt-in now.
		Each block sits in a load folder gated on the mods it touches (see loadFolders.xml); mods with no known packageId keep a name FindMod per operation. Checked with analysis/patch_sim.py against the installed mods:
		every op whose mods are installed applies. Blocks for mods not installed here are unchecked.
		Fix: 28 nested FindMods had their match op written as a bare <li>, so Too Many Mods never applied them; they now apply.
	-->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/StatDef[defName="CarryingCapacity"]/parts/li[@Class="StatPart_Quality"]</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/StatDef[defName="CarryingCapacity"]/parts</xpath>
			<value>
				<li Class="StatPart_Quality">
					<factorAwful>0.5</factorAwful>
					<factorPoor>0.8</factorPoor>
					<factorNormal>1</factorNormal>
					<factorGood>1.2</factorGood>
					<factorExcellent>1.5</factorExcellent>
					<factorMasterwork>1.7</factorMasterwork>
					<factorLegendary>2</factorLegendary>
				</li>
			</value>
		</nomatch>
	</Operation>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Glitter Weaponry</li>
		</mods>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="Laser_Handcannon"]/statBases/RangedWeapon_Cooldown</xpath>
			<value>
				<RangedWeapon_Cooldown>0.5</RangedWeapon_Cooldown>
			</value>
		</match>
	</Operation>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Glitter Weaponry</li>
		</mods>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="Laser_Carbine"]/verbs/li/warmupTime</xpath>
			<value>
				<warmupTime>1.0</warmupTime>
			</value>
		</match>
	</Operation>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Glitter Weaponry</li>
		</mods>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="Laser_Carbine"]/statBases/RangedWeapon_Cooldown</xpath>
			<value>
				<RangedWeapon_Cooldown>2.9</RangedWeapon_Cooldown>
			</value>
		</match>
	</Operation>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Glitter Weaponry</li>
		</mods>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="Laser_Saber"]/tools/li[label="edge"]/armorPenetration</xpath>
			<value>
				<armorPenetration>1.2</armorPenetration>
			</value>
		</match>
	</Operation>

</Patch>
