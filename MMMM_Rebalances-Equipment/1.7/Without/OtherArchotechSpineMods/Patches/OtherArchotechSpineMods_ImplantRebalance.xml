<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Moved here from the root file 1.7/Patches/ImplantRebalance.xml.
		This folder loads only when NONE of the 5 mods listed for this folder in loadFolders.xml is active (see loadFolders.xml). The same condition used to be a
		PatchOperationFindMod on the mod's display name; the load-folder gate uses its packageId instead.
	-->

	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationSequence" MayRequire="lts.I">
				<operations>
					<li Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationReplace">
								<xpath>Defs/HediffDef[defName="LTS_ArchotechSpine"]/addedPartProps/partEfficiency</xpath>
								<value>
									<partEfficiency>1.25</partEfficiency>
								</value>
							</li>
						</operations>
					</li>
				</operations>
			</li>
		</operations>
	</Operation>

</Patch>
