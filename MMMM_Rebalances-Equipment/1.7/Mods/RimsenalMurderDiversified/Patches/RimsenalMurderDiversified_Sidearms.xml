<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Moved here from the root file 1.7/Patches/Sidearms.xml.
		This folder loads only when rimsenal.core is active (see loadFolders.xml). The same condition used to be a
		PatchOperationFindMod on the mod's display name; the load-folder gate uses its packageId instead.
	-->

	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationSequence">
				<operations>
					<li Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationConditional">
								<xpath>Defs/ThingDef[defName="JI_Trollsverd"]/modExtensions/li[@Class="VEF.Things.ThingDefExtension"]/usableWithShields</xpath>
								<nomatch Class="PatchOperationAddModExtension">
									<xpath>Defs/ThingDef[defName="JI_Trollsverd"]</xpath>
									<value>
										<li Class="VEF.Things.ThingDefExtension">
											<usableWithShields>true</usableWithShields>
										</li>
									</value>
								</nomatch>
							</li>
							<li Class="PatchOperationConditional">
								<xpath>Defs/ThingDef[defName="GD_MSSH"]/modExtensions/li[@Class="VEF.Things.ThingDefExtension"]/usableWithShields</xpath>
								<nomatch Class="PatchOperationAddModExtension">
									<xpath>Defs/ThingDef[defName="GD_MSSH"]</xpath>
									<value>
										<li Class="VEF.Things.ThingDefExtension">
											<usableWithShields>true</usableWithShields>
										</li>
									</value>
								</nomatch>
							</li>
							<li Class="PatchOperationConditional">
								<xpath>Defs/ThingDef[defName="TE_KineticPistol"]/modExtensions/li[@Class="VEF.Things.ThingDefExtension"]/usableWithShields</xpath>
								<nomatch Class="PatchOperationAddModExtension">
									<xpath>Defs/ThingDef[defName="TE_KineticPistol"]</xpath>
									<value>
										<li Class="VEF.Things.ThingDefExtension">
											<usableWithShields>true</usableWithShields>
										</li>
									</value>
								</nomatch>
							</li>
						</operations>
					</li>
				</operations>
			</li>
		</operations>
	</Operation>

</Patch>
