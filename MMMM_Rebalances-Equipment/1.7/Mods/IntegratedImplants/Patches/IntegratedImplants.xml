<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Integrated Implants rebalances. This folder only loads when Integrated Implants is active (see loadFolders.xml).
		Voicelock: masochists no longer get the "voicelocked" mood penalty and instead get +8 ("masochist voicelocked",
		Defs/ThoughtDefs.xml). Verified the thought has no nullifyingTraits upstream.
	-->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThoughtDef[defName="LTS_ActiveVoicelock"]</xpath>
		<value>
			<nullifyingTraits>
				<li>Masochist</li>
			</nullifyingTraits>
		</value>
	</Operation>

</Patch>
