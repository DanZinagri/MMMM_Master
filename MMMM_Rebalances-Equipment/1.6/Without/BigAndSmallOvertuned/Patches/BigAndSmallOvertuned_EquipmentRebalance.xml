<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Moved here from the root file 1.6/Patches/EquipmentRebalance.xml.
		This folder loads only when RedMattis.BigSmall.Overtuned is NOT active (see loadFolders.xml). The same condition used to be a
		PatchOperationFindMod on the mod's display name; the load-folder gate uses its packageId instead.
	-->

	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationSequence" MayRequire="RedMattis.BigSmall.Core">
				<operations>
					<li Class="PatchOperationSequence" MayRequireAnyOf="RedMattis.BigSmall,RedMattis.MoreXenos,RedMattis.Yokai,RedMattis.BSSlimes,RedMattis.Heaven,RedMattis.Undead">
						<operations>
							<li Class="PatchOperationSequence">
								<operations>
									<li Class="PatchOperationReplace">
										<xpath>Defs/ThingDef[defName="BS_GiantMinigunBullet"]/projectile/damageAmountBase</xpath>
										<value>
											<damageAmountBase>14</damageAmountBase>
										</value>
									</li>
									<li Class="PatchOperationReplace">
										<xpath>Defs/ThingDef[defName="BS_GiantMinigunBullet"]/projectile/armorPenetrationBase</xpath>
										<value>
											<armorPenetrationBase>0.2</armorPenetrationBase>
										</value>
									</li>
									<li Class="PatchOperationReplace">
										<xpath>Defs/ThingDef[defName="BS_Bullet_JotunRifle"]/projectile/damageAmountBase</xpath>
										<value>
											<damageAmountBase>20</damageAmountBase>
										</value>
									</li>
								</operations>
							</li>
						</operations>
					</li>
				</operations>
			</li>
		</operations>
	</Operation>

</Patch>
