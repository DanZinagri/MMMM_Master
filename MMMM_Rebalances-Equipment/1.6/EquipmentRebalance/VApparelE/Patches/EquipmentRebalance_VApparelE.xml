<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.6/Patches/EquipmentRebalance.xml: the operations that also need Vanilla Apparel Expanded. -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VAE_Apparel_ShirtandTie" or defName="VAE_Apparel_SuitJacket"]/equippedStatOffsets/TradePriceImprovement</xpath>
		<value>
			<NegotiationAbility>0.15</NegotiationAbility>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VAE_Apparel_MilitaryUniform"]/statBases/StuffEffectMultiplierArmor</xpath>
		<value>
			<StuffEffectMultiplierArmor>0.25</StuffEffectMultiplierArmor>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VAE_Apparel_MilitaryJacket"]/statBases/StuffEffectMultiplierArmor</xpath>
		<value>
			<StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VAE_Apparel_Jumpsuit"]/statBases/StuffEffectMultiplierArmor</xpath>
		<value>
			<StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VAE_Apparel_Jeans"]/statBases/StuffEffectMultiplierArmor</xpath>
		<value>
			<StuffEffectMultiplierArmor>0.25</StuffEffectMultiplierArmor>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VAE_Apparel_MilitaryUniform"]/costStuffCount</xpath>
		<value>
			<costStuffCount>140</costStuffCount>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VAE_Apparel_MilitaryUniform"]/costList</xpath>
		<value>
			<costList>
				<Plasteel>20</Plasteel>
			</costList>
		</value>
	</Operation>

</Patch>
