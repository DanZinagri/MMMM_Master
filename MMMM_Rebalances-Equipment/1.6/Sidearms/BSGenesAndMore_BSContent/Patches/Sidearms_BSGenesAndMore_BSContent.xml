<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.6/Patches/Sidearms.xml: the operations that also need Big and Small - Genes & More and Big and Small - Races or Big and Small - More Xenotypes or Big and Small - Yokai or Big and Small - Slimes or Big and Small - Heaven and Hell or Big and Small - Vampires and the Undead. -->

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="BS_JotunJavelin"]/modExtensions/li[@Class="VEF.Things.ThingDefExtension"]/usableWithShields</xpath>
		<nomatch Class="PatchOperationAddModExtension">
			<xpath>Defs/ThingDef[defName="BS_JotunJavelin"]</xpath>
			<value>
				<li Class="VEF.Things.ThingDefExtension">
					<usableWithShields>true</usableWithShields>
				</li>
			</value>
		</nomatch>
	</Operation>

</Patch>
