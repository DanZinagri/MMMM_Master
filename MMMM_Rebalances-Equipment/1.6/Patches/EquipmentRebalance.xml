<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Too Many Mods' equipment rebalance: weapon, armour and apparel stats across many mods. Moved whole from the core root file AA1A_EquipmentRebalance.xml, where it sat behind the
		TMM_EquipmentRebalances setting (default on); installing this mod is the opt-in now.
		Each block is gated on the mods it touches (MayRequire / MayRequireAnyOf on an <li>); mods with no known packageId keep a
		name FindMod; blocks that depend on another mod being present or absent now live in gated load folders (loadFolders.xml). Checked with analysis/patch_sim.py against the installed mods:
		every op whose mods are installed applies. Blocks for mods not installed here are unchecked.
		Fix: 28 nested FindMods had their match op written as a bare <li>, so Too Many Mods never applied them; they now apply.
	-->
	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationSequence" MayRequire="CAT.CryptoPack">
				<operations>
					<li Class="PatchOperationSequence" MayRequire="vanillaquestsexpanded.cryptoforge">
						<operations>
							<li Class="PatchOperationSequence">
								<operations>
									<li Class="PatchOperationReplace">
										<xpath>Defs/ThingDef[defName="CAT_CryptoHarpoonProj"]/projectile/damageAmountBase</xpath>
										<value>
											<damageAmountBase>15</damageAmountBase>
										</value>
									</li>
								</operations>
							</li>
						</operations>
					</li>
				</operations>
			</li>
		</operations>
	</Operation>

