<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.7/Mods/FactionElves/Patches/FactionElves.xml: the operations that also need Big and Small - Genes & More. -->

	<!-- Big and Small - Genes & More: high, celestia, wild and dark elf additions. -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/XenotypeDef[defName="TOV_HighElf"][not(genes/li[text()="BS_InsultProof"])]/genes</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/XenotypeDef[defName="TOV_HighElf"][not(genes/li[text()="BS_InsultProof"])]/genes</xpath>
			<value>
				<li>BS_InsultProof</li>
			</value>
		</match>
	</Operation>
