<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.7/Mods/BigAndSmallSimplyRobots/Patches/BigAndSmallSimplyRobots.xml: the operations that also need Vanilla Races Expanded - Hussar. -->

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/BigAndSmall.DefAltNamer[defName="BS_GeneRenamer"]/geneRenames/li[def="VREH_BulletproofSkin"]</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/BigAndSmall.DefAltNamer[defName="BS_GeneRenamer"]/geneRenames</xpath>
			<value>
				<li>
					<def>VREH_BulletproofSkin</def>
					<labelMechanoid>bulletproof exterior</labelMechanoid>
				</li>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/BigAndSmall.DefAltNamer[defName="BS_GeneRenamer"]/geneRenames/li[def="VREH_Toughness"]</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/BigAndSmall.DefAltNamer[defName="BS_GeneRenamer"]/geneRenames</xpath>
			<value>
				<li>
					<def>VREH_Toughness</def>
					<labelMechanoid>biomimetic shock absorption</labelMechanoid>
				</li>
			</value>
		</nomatch>
	</Operation>

</Patch>
