	<Operation Class="PatchOperationConditional">
		<xpath>Defs/BigAndSmall.DefAltNamer[defName="BS_GeneRenamer"]/geneRenames/li[def="GS_Nimble"]</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/BigAndSmall.DefAltNamer[defName="BS_GeneRenamer"]/geneRenames</xpath>
			<value>
				<li>
					<def>GS_Nimble</def>
					<labelMechanoid>biomimetic dodging</labelMechanoid>
				</li>
			</value>
		</nomatch>
	</Operation>

</Patch>
