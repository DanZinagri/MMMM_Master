<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Mechanical gene names for other mods' genes. The Big and Small Framework's BS_GeneRenamer (a DefAltNamer) makes the
		gene UI show a gene's labelMechanoid instead of its normal label when the pawn is one B&S flags as mechanical (Simply
		Robots' androids and commando bots, among others). B&S covers its own and some vanilla genes; these entries cover
		vanilla Nearsighted / Fire weakness / Inbred / Robust and genes from Alpha Genes, Biotech Expansion, Det's Keshig,
		Brawnum and Venators, Geist, Highborn, Rimsenal Askbarn and Harana, and VRE Archon, Hussar, Pigskin and Saurid, each
		block MayRequire'd on its mod. Label text only; stats and non-mechanical pawns are unaffected.
		This folder only loads when Simply Robots is active (see loadFolders.xml), as in the original.

		Every entry is guarded: it is added only if no rename for that gene exists yet. B&S builds its lookup with ToDictionary
		over all rename entries, so a duplicate gene throws and breaks every gene rename. The original guarded only the
		vanilla-gene entries; the guard now covers all of them.
	-->

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/BigAndSmall.DefAltNamer[defName="BS_GeneRenamer"]/geneRenames/li[def="Nearsighted"]</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/BigAndSmall.DefAltNamer[defName="BS_GeneRenamer"]/geneRenames</xpath>
			<value>
				<li>
					<def>Nearsighted</def>
					<labelMechanoid>short-focus sensor</labelMechanoid>
				</li>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/BigAndSmall.DefAltNamer[defName="BS_GeneRenamer"]/geneRenames/li[def="FireWeakness"]</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/BigAndSmall.DefAltNamer[defName="BS_GeneRenamer"]/geneRenames</xpath>
			<value>
				<li>
					<def>FireWeakness</def>
					<labelMechanoid>flame-sensitive shell</labelMechanoid>
				</li>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/BigAndSmall.DefAltNamer[defName="BS_GeneRenamer"]/geneRenames/li[def="Inbred"]</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/BigAndSmall.DefAltNamer[defName="BS_GeneRenamer"]/geneRenames</xpath>
			<value>
				<li>
					<def>Inbred</def>
					<labelMechanoid>energy-saving nanomachines</labelMechanoid>
				</li>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/BigAndSmall.DefAltNamer[defName="BS_GeneRenamer"]/geneRenames/li[def="Robust"]</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/BigAndSmall.DefAltNamer[defName="BS_GeneRenamer"]/geneRenames</xpath>
			<value>
				<li>
					<def>Robust</def>
					<labelMechanoid>shock absorption</labelMechanoid>
				</li>
			</value>
		</nomatch>
	</Operation>

</Patch>
