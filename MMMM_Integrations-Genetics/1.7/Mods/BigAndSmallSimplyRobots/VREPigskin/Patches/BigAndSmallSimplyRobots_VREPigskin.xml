	<Operation Class="PatchOperationConditional">
		<xpath>Defs/BigAndSmall.DefAltNamer[defName="BS_GeneRenamer"]/geneRenames/li[def="VRE_OrganRegeneration"]</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/BigAndSmall.DefAltNamer[defName="BS_GeneRenamer"]/geneRenames</xpath>
			<value>
				<li>
					<def>VRE_OrganRegeneration</def>
					<labelMechanoid>internal self-reconstruction</labelMechanoid>
				</li>
			</value>
		</nomatch>
	</Operation>

</Patch>
