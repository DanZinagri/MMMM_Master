<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.7/Mods/KorgXenotype/Patches/KorgXenotype.xml: the operations that also need Alpha Genes. -->

	<!-- Alpha Genes: Korg additions. -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/XenotypeDef[defName="Korg"][not(genes/li[text()="AG_HardBones"])]/genes</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/XenotypeDef[defName="Korg"][not(genes/li[text()="AG_HardBones"])]/genes</xpath>
