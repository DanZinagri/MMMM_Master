<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.7/Mods/AlphaGenes/Patches/AlphaGenes.xml: the operations that also need ReGrowth 2. -->

	<!--
		Alpha Genes + ReGrowth 2: water striding nullifies ReGrowth's "wet" and "extremely wet" thoughts. Verified both
		are ThoughtDefs with no nullifyingGenes list yet; the conditionals create one.
	-->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/*[defName="RG_Wet"]/nullifyingGenes</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/*[defName="RG_Wet"]</xpath>
			<value>
				<nullifyingGenes/>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/*[defName="RG_Wet"]/nullifyingGenes</xpath>
		<value>
			<li>AG_WaterStriding</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/*[defName="RG_ExtremelyWet"]/nullifyingGenes</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/*[defName="RG_ExtremelyWet"]</xpath>
			<value>
				<nullifyingGenes/>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/*[defName="RG_ExtremelyWet"]/nullifyingGenes</xpath>
		<value>
			<li>AG_WaterStriding</li>
		</value>
	</Operation>

</Patch>
