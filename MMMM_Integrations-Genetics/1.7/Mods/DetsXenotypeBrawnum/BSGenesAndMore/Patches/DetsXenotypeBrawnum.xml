<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		The Brawnum xenotype gains Big and Small's Large body size gene.
		This folder only loads when Det's Xenotypes - Brawnum is active (see loadFolders.xml); Big and Small is gated by subfolder because the gene comes from there.
		Verified against Brawnum 1.6: the xenotype does not already list Large.
	-->
	<!--
		Operations that also need another mod sit in a subfolder gated on it in loadFolders.xml. Do not flatten this wrapper away.
	-->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/XenotypeDef[defName="DV_Brawnum"]/genes</xpath>
		<value>
			<li>Large</li>
		</value>
	</Operation>

</Patch>
