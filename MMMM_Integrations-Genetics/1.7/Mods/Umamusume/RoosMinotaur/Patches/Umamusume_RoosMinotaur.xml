<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Umamusume + Roo's Minotaur Xenotype: estrous cycle.
		Verified 2026-11-24 against Umamusume: Rim Derby (3552197538, Uma_Biotech/1.6/Defs/UmaXenotype.xml; it has no 1.7 folder and loads 1.6 on 1.7).
	-->

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/XenotypeDef[defName="JTCUmamusume"][not(genes/li[text()="RBM_EstrousCycle"])]/genes</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/XenotypeDef[defName="JTCUmamusume"][not(genes/li[text()="RBM_EstrousCycle"])]/genes</xpath>
			<value>
				<li>RBM_EstrousCycle</li>
			</value>
		</match>
	</Operation>

</Patch>
