<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Alpha Genes content taught about Big and Small.
		- The medium and major armour genes gain a B&amp;S pawn extension, so a pawn who also carries a gene that
		forbids armour or apparel gets a matching tough-skin or natural-armour hediff instead of nothing, plus
		effect text saying so.
		- Three display categories are pointed at the Alpha Genes ones so the B&amp;S horn and armour genes sort into
		the same gene-list sections, and the Alpha Genes gene tools category moves under Items.
		This folder only loads when B&amp;S - Genes &amp; More is active (see loadFolders.xml); Alpha Genes is gated inside.
		The mod gate sits on an <li> inside a sequence, not on the <Operation> itself: RimWorld reads
		MayRequire only on list elements, so an <Operation MayRequire="..."> node loads and applies
		unconditionally.

		Verified against the current 1.6 releases: BS_Hornbase is displayCategory BS_Horns, BS_NaturalArmor_Great is
		Archite, the AG_GeneTools category parent is Manufactured, and both Alpha Genes category defs exist, so all
		four land.

		AG_ArmourMedium and AG_ArmourMajor already define customEffectDescriptions upstream (the natural armour
		percentage), so the two B&amp;S lines are added into that list, keeping the upstream line; a gene without the
		list gets a new one. Fix 2026-10-31: these adds used to append a second customEffectDescriptions node, and
		whichever node came last won, so either the armour line or the B&amp;S lines vanished depending on whether
		MMMM Rebalances - Genetics (which rewrites the armour line) loaded before or after this mod.
		Split by category into the MMMM Integrations sub-mods: this copy holds only the Genetics ops (genes and xenotypes).
	-->
	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationSequence" MayRequire="sarg.alphagenes">
				<operations>
					<li Class="PatchOperationConditional">
						<xpath>Defs/GeneDef[defName="AG_ArmourMedium"]/customEffectDescriptions</xpath>
						<match Class="PatchOperationAdd">
							<xpath>Defs/GeneDef[defName="AG_ArmourMedium"]/customEffectDescriptions</xpath>
							<value>
								<li>Increased effect when combined with genes preventing wearing armor</li>
								<li>Nearly doubled effect when combined with genes preventing wearing apparel</li>
							</value>
						</match>
						<nomatch Class="PatchOperationAdd">
							<xpath>Defs/GeneDef[defName="AG_ArmourMedium"]</xpath>
							<value>
								<customEffectDescriptions>
									<li>Increased effect when combined with genes preventing wearing armor</li>
									<li>Nearly doubled effect when combined with genes preventing wearing apparel</li>
								</customEffectDescriptions>
							</value>
						</nomatch>
					</li>
					<li Class="PatchOperationAddModExtension">
						<xpath>Defs/GeneDef[defName="AG_ArmourMedium"]</xpath>
						<value>
							<li Class="BigAndSmall.PawnExtension">
								<applyBodyHediff>
									<li>
										<hediff>BS_ToughSkin_NoArmor</hediff>
										<prerequisiteSets>
											<li>
												<type>AnyOf</type>
												<prerequisites>
													<li>BS_CannotWearArmor</li>
												</prerequisites>
											</li>
										</prerequisiteSets>
									</li>
									<li>
										<hediff>BS_ToughSkin_NoApparel</hediff>
										<prerequisiteSets>
											<li>
												<type>AnyOf</type>
												<prerequisites>
													<li>BS_CannotWearClothingOrArmor</li>
												</prerequisites>
											</li>
										</prerequisiteSets>
									</li>
								</applyBodyHediff>
							</li>
						</value>
					</li>
					<li Class="PatchOperationConditional">
						<xpath>Defs/GeneDef[defName="AG_ArmourMajor"]/customEffectDescriptions</xpath>
						<match Class="PatchOperationAdd">
							<xpath>Defs/GeneDef[defName="AG_ArmourMajor"]/customEffectDescriptions</xpath>
							<value>
								<li>Increased effect when combined with genes preventing wearing armor</li>
								<li>Nearly doubled effect when combined with genes preventing wearing apparel</li>
							</value>
						</match>
						<nomatch Class="PatchOperationAdd">
							<xpath>Defs/GeneDef[defName="AG_ArmourMajor"]</xpath>
							<value>
								<customEffectDescriptions>
									<li>Increased effect when combined with genes preventing wearing armor</li>
									<li>Nearly doubled effect when combined with genes preventing wearing apparel</li>
								</customEffectDescriptions>
							</value>
						</nomatch>
					</li>
					<li Class="PatchOperationAddModExtension">
						<xpath>Defs/GeneDef[defName="AG_ArmourMajor"]</xpath>
						<value>
							<li Class="BigAndSmall.PawnExtension">
								<applyBodyHediff>
									<li>
										<hediff>BS_NaturalArmor_NoArmor</hediff>
										<prerequisiteSets>
											<li>
												<type>AnyOf</type>
												<prerequisites>
													<li>BS_CannotWearArmor</li>
												</prerequisites>
											</li>
										</prerequisiteSets>
									</li>
									<li>
										<hediff>BS_NaturalArmor_NoApparel</hediff>
										<prerequisiteSets>
											<li>
												<type>AnyOf</type>
												<prerequisites>
													<li>BS_CannotWearClothingOrArmor</li>
												</prerequisites>
											</li>
										</prerequisiteSets>
									</li>
								</applyBodyHediff>
							</li>
						</value>
					</li>
					<li Class="PatchOperationReplace">
						<xpath>Defs/GeneDef[@Name="BS_Hornbase"]/displayCategory</xpath>
						<value>
							<displayCategory>AG_Cosmetic_Horns</displayCategory>
						</value>
					</li>
					<li Class="PatchOperationReplace">
						<xpath>Defs/GeneDef[defName="BS_NaturalArmor_Great"]/displayCategory</xpath>
						<value>
							<displayCategory>AG_Armour</displayCategory>
						</value>
					</li>
				</operations>
			</li>
		</operations>
	</Operation>

</Patch>
