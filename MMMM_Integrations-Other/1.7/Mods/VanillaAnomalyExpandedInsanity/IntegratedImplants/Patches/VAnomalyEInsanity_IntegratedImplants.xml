		<xpath>Defs/HediffDef[defName="LTS_Voidlink"]/stages/li[label="roaring"]/statOffsets/MentalBreakThreshold</xpath>
		<value>
			<VAEI_SanityMultiplier>0.60</VAEI_SanityMultiplier>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/HediffDef[defName="LTS_Voidlink"]/stages/li[label="screaming"]/statOffsets/MentalBreakThreshold</xpath>
		<value>
			<VAEI_SanityMultiplier>0.80</VAEI_SanityMultiplier>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/HediffDef[defName="LTS_Voidlink"]/stages/li[label="cacophonous"]/statOffsets/MentalBreakThreshold</xpath>
