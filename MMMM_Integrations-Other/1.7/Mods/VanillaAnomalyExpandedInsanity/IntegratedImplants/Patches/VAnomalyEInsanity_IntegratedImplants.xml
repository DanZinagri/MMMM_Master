<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.7/Mods/VanillaAnomalyExpandedInsanity/Patches/VanillaAnomalyExpandedInsanity.xml: the operations that also need Integrated Implants. -->

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/VAEInsanity.SanityEffectsDef[defName="VAEI_SanityEffects"]/hediffEffects</xpath>
		<value>
			<li>
				<hediff>MetalhorrorSymbiont</hediff>
				<effect>-0.004</effect>
			</li>
			<li>
				<hediff>Blacksight</hediff>
				<effect>-0.04</effect>
			</li>
			<li>
				<hediff>DreadheartRegeneration</hediff>
				<effect>-0.20</effect>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
