<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.6/Patches/Horns.xml: the operations that also need Alpha Genes and Roo's Minotaur Xenotype. -->

	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/GeneDef[defName="RBM_BovineHorns"]</xpath>
		<value>
			<li Class="VEF.Genes.GeneExtension">
				<hediffsToBodyParts>
					<li>
						<hediff>AG_HornAttack</hediff>
						<bodyparts>
							<li>Head</li>
						</bodyparts>
					</li>
				</hediffsToBodyParts>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/GeneDef[defName="RBM_BovineHorns"]</xpath>
		<value>
			<customEffectDescriptions>
				<li>Adds a 16 stab damage, 3 seconds cooldown melee attack</li>
			</customEffectDescriptions>
		</value>
	</Operation>

</Patch>
