<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.6/Patches/Wings.xml: the operations that also need Rimsenal.Harana and Alpha Genes. -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="Gene_ShortJump"]/biostatMet</xpath>
		<value>
			<biostatMet>-1</biostatMet>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/GeneDef[defName="Gene_Hwing"]</xpath>
		<value>
			<biostatMet>-2</biostatMet>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="Gene_Hwing"]/biostatCpx</xpath>
		<value>
			<biostatCpx>1</biostatCpx>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/GeneDef[defName="Gene_Hwing"]</xpath>
		<value>
			<customEffectDescriptions>
				<li>Colonist will ignore terrain movement costs</li>
			</customEffectDescriptions>
		</value>
	</Operation>

</Patch>
