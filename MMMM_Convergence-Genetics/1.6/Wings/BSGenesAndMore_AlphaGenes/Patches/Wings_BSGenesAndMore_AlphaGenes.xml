<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.6/Patches/Wings.xml: the operations that also need Big and Small - Genes & More and Alpha Genes. -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[@Name="BS_SpoderLegs"]/biostatMet</xpath>
		<value>
			<biostatMet>-3</biostatMet>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[@Name="BS_FunctionalWingBase"]/biostatMet</xpath>
		<value>
			<biostatMet>-2</biostatMet>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[@Name="BS_FunctionalWingBase"]/biostatCpx</xpath>
		<value>
			<biostatCpx>2</biostatCpx>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[@Name="BS_FunctionalWingBase"]/customEffectDescriptions</xpath>
		<value>
			<customEffectDescriptions>
				<li>Colonist will ignore terrain movement costs</li>
			</customEffectDescriptions>
		</value>
	</Operation>
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/GeneDef[@Name="BS_FunctionalWingBase"]/abilities</xpath>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/GeneDef[@Name="BS_FunctionalWingBase"]</xpath>
		<value>
			<abilities Inherit="False">
				<li>AG_WingPoweredJump</li>
			</abilities>
		</value>
	</Operation>

</Patch>
