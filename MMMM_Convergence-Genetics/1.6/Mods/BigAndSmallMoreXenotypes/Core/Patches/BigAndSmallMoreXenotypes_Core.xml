<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Big and Small - More Xenotypes: genes swapped for other mods' equivalents, so the same effect is not provided
		twice under two names.
		This folder only loads when More Xenotypes is active (see loadFolders.xml); each swap sits in a subfolder gated on the mod that supplies the replacement.
		Verified against the current 1.6 releases: every gene being replaced is present in its xenotype, so all of
		these land.
	-->
	<!-- Parasite uses Biotech Expansion's feral might instead of B&S very strong unarmed -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/XenotypeDef[defName="BS_Parasite"]/genes/li[text()="BS_Unarmed_VeryStrong"]</xpath>
		<value>
			<li>BTE_FeralMight</li>
		</value>
	</Operation>

</Patch>
