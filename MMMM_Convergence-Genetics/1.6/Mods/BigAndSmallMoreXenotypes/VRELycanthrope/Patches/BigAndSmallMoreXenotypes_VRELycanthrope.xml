<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.6/Mods/BigAndSmallMoreXenotypes/Patches/BigAndSmallMoreXenotypes.xml: the operations that also need Vanilla Races Expanded - Lycanthrope. -->

	<!-- Weaver and parasite use VRE Lycanthrope's nocturnal gene instead of B&S night owl -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/XenotypeDef[defName="BS_Weaver" or defName="BS_Parasite"]/genes/li[text()="BS_NightOwl"]</xpath>
		<value>
			<li>VRE_Nocturnal</li>
		</value>
	</Operation>

</Patch>
