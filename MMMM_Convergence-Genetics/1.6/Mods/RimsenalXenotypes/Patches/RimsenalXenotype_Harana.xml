<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Rimsenal Xenotype Pack - Harana overlap removal:
		  - With Det's Stoneborn: Harana are irascible (Stoneborn's gene) instead of Rimsenal's passively aggressive gene,
		    which goes on this mod's Cherry Picker list (revive entry in 1.6/Defs/CherryPicker.xml). Only Harana carries it.
		  - With VRE Archon: Harana gain Archon's fast melee hitter.
		  - With Askbarn: Harana's agile striker and Askbarn's lightning reflexes both cut aiming delay, so they share a new
		    AimingDelay exclusion group (neither gene had exclusion tags; nothing else carries the tag).
		This folder loads when a Rimsenal xenotype pack is active (see loadFolders.xml); each block is gated on its mods via an <li>.
		Verified against Harana, Askbarn and Stoneborn 1.6. VRE Archon is not installed here, so VRE_FastMeleeHitter is unchecked.
	-->
	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationSequence" MayRequire="Rimsenal.Harana,det.stoneborn">
				<operations>
					<li Class="PatchOperationReplace">
						<xpath>Defs/XenotypeDef[defName="Harana"]/genes/li[text()="Aggression_PassivelyAggressive"]</xpath>
						<value>
							<li>DV_Aggression_Irascible</li>
						</value>
					</li>
					<li Class="PatchOperationAdd">
						<xpath>Defs/CherryPicker.DefList[defName="MMMM_ConvergenceGenetics_CherryPicker_Basics"]/defs</xpath>
						<value>
							<li>GeneDef/Aggression_PassivelyAggressive</li>
						</value>
					</li>
				</operations>
			</li>
		</operations>
	</Operation>

	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationSequence" MayRequire="Rimsenal.Harana,vanillaracesexpanded.archon">
				<operations>
					<li Class="PatchOperationAdd">
						<xpath>Defs/XenotypeDef[defName="Harana"]/genes</xpath>
						<value>
							<li>VRE_FastMeleeHitter</li>
						</value>
					</li>
				</operations>
			</li>
		</operations>
	</Operation>

	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationSequence" MayRequire="Rimsenal.Harana,Rimsenal.Askbarn">
				<operations>
					<li Class="PatchOperationAdd">
						<xpath>Defs/GeneDef[defName="AgileStriker"]</xpath>
						<value>
							<exclusionTags>
								<li>AimingDelay</li>
							</exclusionTags>
						</value>
					</li>
					<li Class="PatchOperationAdd">
						<xpath>Defs/GeneDef[defName="RSLightningReflexes"]</xpath>
						<value>
							<exclusionTags>
								<li>AimingDelay</li>
							</exclusionTags>
						</value>
					</li>
				</operations>
			</li>
		</operations>
	</Operation>

</Patch>
