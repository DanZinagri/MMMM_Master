<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Rimsenal Xenotype Pack - Zohar + Alpha Genes: the Zohar's sensitive stomach becomes Alpha Genes' frail stomach, and
		Zohar's gene goes on this mod's Cherry Picker list (revive entry in 1.6/Defs/CherryPicker.xml).
		This folder loads when any Rimsenal xenotype pack is active (see loadFolders.xml); its operations sit in a subfolder gated on Zohar and
		Alpha Genes.
		Verified against Zohar and Alpha Genes 1.6: only the Zohar xenotype carries Gene_SensitiveStomach, and AG_FrailStomach
		exists. Character Development - Additional Gene Quirks also lists Gene_SensitiveStomach in a reward.
	-->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/XenotypeDef[defName="Zohar"]/genes/li[text()="Gene_SensitiveStomach"]</xpath>
		<value>
			<li>AG_FrailStomach</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/CherryPicker.DefList[defName="MMMM_ConvergenceGenetics_CherryPicker_Basics"]/defs</xpath>
		<value>
			<li>GeneDef/Gene_SensitiveStomach</li>
		</value>
	</Operation>

</Patch>
