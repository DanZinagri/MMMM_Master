<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Vanilla Races Expanded - Hussar + Big and Small - Simple Size Genes (without Genes & More): any xenotype with VRE
		Hussar's giant gene (the Uhlan) takes B&S's large frame instead, and VREH_Giant is retired to this mod's Cherry Picker
		list.
		Folder gated on vanillaracesexpanded.hussar and RedMattis.BigSmall.SimpleSize, and only when RedMattis.BigSmall.Core is NOT active (loadFolders.xml); with Genes & More the
		Genes & More folders run instead. Simple Size Genes ships these defs under B&S's defNames (verified 2026-11-13).
	-->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/XenotypeDef/genes/li[text()="VREH_Giant"]</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/XenotypeDef/genes/li[text()="VREH_Giant"]</xpath>
			<value>
				<li>BS_LargeFrame</li>
			</value>
		</match>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/CherryPicker.DefList[defName="MMMM_ConvergenceGenetics_CherryPicker_Basics"]/defs</xpath>
		<value>
			<li>GeneDef/VREH_Giant</li>
			<li>GeneDef/VREH_Giant_Astrogene</li>
		</value>
	</Operation>

</Patch>
