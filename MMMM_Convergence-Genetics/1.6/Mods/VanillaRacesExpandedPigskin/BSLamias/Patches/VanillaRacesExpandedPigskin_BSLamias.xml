<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.6/Mods/VanillaRacesExpandedPigskin/Patches/VanillaRacesExpandedPigskin.xml: the operations that also need Big and Small - Lamias and other Snake-People. -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/XenotypeDef[defName="Naga" or defName="LoS_Silver"]/genes/li[text()="BS_SlowAging"]</xpath>
		<value>
			<li>VRE_SlowAging</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/XenotypeDef[defName="LoS_Adderman"]/genes/li[text()="BS_FastAging"]</xpath>
		<value>
			<li>VRE_FastAging</li>
		</value>
	</Operation>

</Patch>
