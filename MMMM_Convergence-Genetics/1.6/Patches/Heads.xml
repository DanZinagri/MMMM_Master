	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationSequence" MayRequire="vanillaracesexpanded.genie">
				<operations>
					<li Class="PatchOperationSequence" MayRequire="sarg.alphagenes">
						<operations>
							<li Class="PatchOperationSequence">
								<operations>
									<li Class="PatchOperationAdd">
										<xpath>/Defs/GeneDef[defName="VRE_ElongatedHead"]</xpath>
										<value>
											<exclusionTags>
												<li>AG_Heads</li>
												<li>Heads</li>
												<li>Head</li>
											</exclusionTags>
										</value>
									</li>
								</operations>
							</li>
						</operations>
					</li>
				</operations>
			</li>
		</operations>
	</Operation>

</Patch>
