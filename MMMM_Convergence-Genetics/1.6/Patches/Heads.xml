									<li Class="PatchOperationAdd">
										<xpath>/Defs/GeneDef[defName="Narrow_Pointy_Head" or defName="Narrow_Normal_Head"]</xpath>
										<value>
											<exclusionTags>
												<li>AG_Heads</li>
												<li>Heads</li>
												<li>Head</li>
											</exclusionTags>
										</value>
									</li>
								</operations>
							</li>
						</operations>
					</li>
				</operations>
			</li>
		</operations>
	</Operation>

	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationSequence" MayRequire="Rimsenal.Askbarn">
				<operations>
					<li Class="PatchOperationSequence" MayRequire="sarg.alphagenes">
