<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Vanilla Races Expanded - Pigskin and Big and Small overlap.
		- Boarskin uses Endless growth (BS_EndlessGrowth) instead of VRE Evergrowing.
		- Big and Small xenotypes use VRE Pigskin aging genes (VRE_SlowAging / VRE_FastAging / VRE_RapidAging) instead of
		BS_VerySlowAging / BS_SlowAging / BS_FastAging / BS_VeryFastAging; each block sits in a subfolder gated on the B&amp;S sub-mod it belongs to.
		- The retired duplicates are handed to Cherry Picker.
		This folder only loads when both VRE - Pigskin and Big and Small - Genes &amp; More are active (see loadFolders.xml), so no FindMod checks are needed.
		Fix 2026-10-03: genes retired to Cherry Picker are now swapped in every xenotype that carries them (removed where the
		xenotype already has the replacement), so no xenotype from any mod loses one. Genes without a clean one-for-one
		replacement are no longer retired.
	-->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/XenotypeDef[defName="VRE_Boarskin"]/genes/li[text()="VRE_EverGrowing"]</xpath>
		<value>
			<li MayRequire="RedMattis.BigSmall.Core">BS_EndlessGrowth</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/CherryPicker.DefList[defName="MMMM_ConvergenceGenetics_CherryPicker_Basics"]/defs</xpath>
		<value>
			<li>GeneDef/VRE_EverGrowing</li>
			<li>GeneDef/VRE_EverGrowing_Astrogene</li>
			<li>GeneDef/BS_VerySlowAging</li>
			<li>GeneDef/BS_SlowAging</li>
			<li>GeneDef/BS_FastAging</li>
			<li>GeneDef/BS_VeryFastAging</li>
		</value>
	</Operation>

</Patch>
