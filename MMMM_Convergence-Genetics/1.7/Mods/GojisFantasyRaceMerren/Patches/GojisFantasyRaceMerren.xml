<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Goji's Fantasy Race: Merren overlap removal. This folder only loads when Merren is active (see loadFolders.xml).
		  - Merren's nimbleness joins the shared MeleeDodge exclusion group.
		  - With Geist: the Geist uses Merren's nimbleness instead of its own nimble gene, which goes on this mod's Cherry
		    Picker list (revive entries in 1.7/Defs/CherryPicker.xml).
		The original core folder was gated on packageId "Goji.Merren", which no mod has, so none of this ever loaded; the
		gate is now Arquebus.StagzMerfolk, confirmed against Merren's About.xml. Verified against Merren 1.7: Stagz_Nimbleness
		has no exclusionTags of its own, and the Geist carries GS_Nimble.
		1.7 note (2026-10-20): Merren 1.7 removed Stagz_SwiftSwim, Stagz_KeenReflexes and Stagz_WebbedHands (its xenotypes
		now use vanilla WebbedPhalanges, with no swim gene). This 1.7 copy drops what targeted them: the Alpha Genes water
		striding swap (and the water striding prerequisite and Nereid aquatic gene that only existed to support it), keen
		reflexes in the exclusion group, and the swift swim Cherry Picker entries. The 1.6 copy is unchanged.
	-->
	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationAdd">
				<xpath>Defs/GeneDef[defName="Stagz_Nimbleness"]</xpath>
				<value>
					<exclusionTags>
						<li>MeleeDodge</li>
					</exclusionTags>
				</value>
			</li>
		</operations>
	</Operation>

	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationSequence" MayRequire="Sov.Tenmo">
				<operations>
					<li Class="PatchOperationReplace">
						<xpath>Defs/XenotypeDef[defName="GS_Geist"]/genes/li[text()="GS_Nimble"]</xpath>
						<value>
							<li>Stagz_Nimbleness</li>
						</value>
					</li>
					<li Class="PatchOperationAdd">
						<xpath>Defs/CherryPicker.DefList[defName="MMMM_ConvergenceGenetics_CherryPicker_Basics"]/defs</xpath>
						<value>
							<li>GeneDef/GS_Nimble</li>
							<li>GeneDef/GS_Nimble_Astrogene</li>
						</value>
					</li>
				</operations>
			</li>
		</operations>
	</Operation>

</Patch>
