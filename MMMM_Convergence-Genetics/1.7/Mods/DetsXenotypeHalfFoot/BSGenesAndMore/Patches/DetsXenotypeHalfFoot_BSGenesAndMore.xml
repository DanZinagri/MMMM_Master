<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Also loads with Big and Small - Simple Size Genes (RedMattis.BigSmall.SimpleSize, without Genes & More): every def this file touches is
	one of the size genes or traits Simple Size Genes ships under the same defName (verified 2026-11-13). -->

	<!-- Split from 1.7/Mods/DetsXenotypeHalfFoot/Patches/DetsXenotypeHalfFoot.xml: the operations that also need Big and Small - Genes & More. -->

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/XenotypeDef/genes/li[text()="DV_ExtrasmallBuild"]</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/XenotypeDef/genes/li[text()="DV_ExtrasmallBuild"]</xpath>
			<value>
				<li>BS_SmallFrame</li>
			</value>
		</match>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/XenotypeDef[defName="DV_Halffoot"]/genes/li[text()="MeleeDamage_Weak"]</xpath>
		<match Class="PatchOperationRemove">
			<xpath>Defs/XenotypeDef[defName="DV_Halffoot"]/genes/li[text()="MeleeDamage_Weak"]</xpath>
		</match>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/CherryPicker.DefList[defName="MMMM_ConvergenceGenetics_CherryPicker_Basics"]/defs</xpath>
		<value>
			<li>GeneDef/DV_ExtrasmallBuild</li>
		</value>
	</Operation>

</Patch>
