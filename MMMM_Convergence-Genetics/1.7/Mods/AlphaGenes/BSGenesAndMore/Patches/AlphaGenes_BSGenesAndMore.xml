<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.7/Mods/AlphaGenes/Patches/AlphaGenes.xml: the operations that also need Big and Small - Genes & More. -->

	<!--
		Big and Small - Genes & More: the Helixien's slow movement becomes B&S's very slow gene, and the Taukai's
		painlessness becomes B&S's no-pain gene (only if the Taukai still carries AG_Painless).
		Verified against Alpha Genes and B&S 1.6: both genes being replaced are in those xenotypes, and both B&S genes exist.
	-->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/XenotypeDef[defName="AG_Helixien"]/genes/li[text()="MoveSpeed_Slow"]</xpath>
		<value>
			<li>BS_Very_Slow</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/XenotypeDef[defName="AG_Taukai"]/genes/li[text()="AG_Painless"]</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/XenotypeDef[defName="AG_Taukai"]/genes/li[text()="AG_Painless"]</xpath>
			<value>
				<li>BS_Pain_None</li>
			</value>
		</match>
	</Operation>

	<!--
		Alpha Genes + Big and Small: any other xenotype with Alpha Genes' larger body size takes B&S's large frame instead,
		so the cherry-picked gene (1.6/Patches/CherryPicks.xml, same gate) leaves no xenotype without a size gene.
	-->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/XenotypeDef/genes/li[text()="AG_LargerBodySize"]</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/XenotypeDef/genes/li[text()="AG_LargerBodySize"]</xpath>
			<value>
				<li>BS_LargeFrame</li>
			</value>
		</match>
	</Operation>

</Patch>
