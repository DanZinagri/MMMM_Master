<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.7/Patches/Wings.xml: the operations that also need Alpha Genes and Nephilim Xenotype Reborn. -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="GS_WingsB"]/biostatCpx</xpath>
		<value>
			<biostatCpx>2</biostatCpx>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="GS_WingsB"]/biostatMet</xpath>
		<value>
			<biostatMet>-2</biostatMet>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/GeneDef[defName="GS_WingsB"]</xpath>
		<value>
			<customEffectDescriptions>
				<li>Colonist will ignore terrain movement costs</li>
			</customEffectDescriptions>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="GS_short_glide"]/biostatMet</xpath>
		<value>
			<biostatMet>-1</biostatMet>
		</value>
	</Operation>

</Patch>
