<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.7/Patches/Wings.xml: the operations that also need Vanilla Races Expanded - Insector. -->

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/VanillaRacesExpandedInsector.GenelineGeneDef[defName="VRE_InsectWings"]/exclusionTags</xpath>
		<value>
			<li>Wing</li>
			<li>Wings</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/VanillaRacesExpandedInsector.GenelineGeneDef[defName="VRE_InsectWings"]/waterCellCost</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/VanillaRacesExpandedInsector.GenelineGeneDef[defName="VRE_InsectWings"]</xpath>
			<value>
				<waterCellCost>1</waterCellCost>
			</value>
		</nomatch>
	</Operation>

</Patch>
