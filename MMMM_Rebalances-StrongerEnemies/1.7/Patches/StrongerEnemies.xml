<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Stronger enemies: tougher raider, mercenary, deserter, Empire and Horaxian pawn kinds across many mods (gear, hediffs,
		psycasters, pawn group options). Moved from the core root file AA3A_StrongerEnemies.xml (setting TMM_StrongerEnemies,
		default on; installing this mod is the opt-in now). The new pawn kinds it adds are in 1.7/Defs/StrongerEnemies_PawnKinds.xml
		(def-level MayRequire); two Empire casters behind the Medieval Overhaul: Royalty name check stay patch adds here.
		Each block sits in a subfolder gated on its mods; mods with no known packageId keep a name FindMod.
		Dropped as stale (they failed in Too Many Mods too, and a failure stopped the rest of its sequence): ops on
		VFEE_Deserter_Protector / _Harmonist and Empire_Fighter_Cataphract_Hussar, and five VFEE_Deserter_* raid options; no
		installed mod defines those pawn kinds. Checked with analysis/patch_sim.py: every installed-mod op applies (the Empire
		psycaster raid group it trims is added by VPE's own patch).
	-->

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/PawnKindDef[@Name="MercenaryEliteBase"]</xpath>
		<value>
			<itemQuality>Good</itemQuality>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/PawnKindDef[defName="PirateBoss"]</xpath>
		<value>
			<itemQuality>Excellent</itemQuality>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/PawnKindDef[@Name="TribalChiefBase"]/itemQuality</xpath>
		<value>
			<itemQuality>Excellent</itemQuality>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/PawnKindDef[@Name="TribalChiefBase"]</xpath>
		<value>
			<skills>
				<li>
					<skill>Melee</skill>
					<range>14~18</range>
				</li>
				<li>
					<skill>Shooting</skill>
					<range>14~18</range>
				</li>
			</skills>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/PawnKindDef[defName="Tribal_Berserker"]</xpath>
		<value>
			<skills>
				<li>
					<skill>Melee</skill>
					<range>12~16</range>
				</li>
				<li>
					<skill>Intellectual</skill>
					<range>0~2</range>
				</li>
			</skills>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/PawnKindDef[defName="Tribal_Warrior"]</xpath>
		<value>
			<skills>
				<li>
					<skill>Melee</skill>
					<range>10~16</range>
				</li>
			</skills>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/PawnKindDef[defName="Tribal_Hunter"]</xpath>
		<value>
			<skills>
				<li>
					<skill>Shooting</skill>
					<range>10~16</range>
				</li>
			</skills>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/PawnKindDef[defName="Tribal_Archer"]</xpath>
		<value>
			<skills>
				<li>
					<skill>Shooting</skill>
					<range>10~16</range>
				</li>
			</skills>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/PawnKindDef[defName="Tribal_HeavyArcher"]</xpath>
		<value>
			<skills>
				<li>
					<skill>Shooting</skill>
					<range>10~16</range>
				</li>
			</skills>
		</value>
	</Operation>

</Patch>
