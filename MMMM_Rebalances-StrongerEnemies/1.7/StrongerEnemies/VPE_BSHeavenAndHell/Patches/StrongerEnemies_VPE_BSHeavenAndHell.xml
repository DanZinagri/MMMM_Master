<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.7/Patches/StrongerEnemies.xml: the operations that also need Vanilla Psycasts Expanded and Big and Small - Heaven and Hell. -->

	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/PawnKindDef[defName="BS_Satan"]</xpath>
		<value>
			<li Class="VanillaPsycastsExpanded.PawnKindAbilityExtension_Psycasts">
				<implantDef>VPE_PsycastAbilityImplant</implantDef>
				<initialLevel>1</initialLevel>
				<statUpgradePoints>0~0</statUpgradePoints>
				<unlockedPaths>
					<VPE_Necropath>1~4|1~10</VPE_Necropath>
				</unlockedPaths>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/PawnKindDef[defName="BS_Satan"]/startingHediffs</xpath>
		<value>
			<li>
				<def>VPE_GainedVitality</def>
				<chance>0.5</chance>
				<durationTicksRange>40000~55000</durationTicksRange>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/PawnKindDef[defName="BS_AuthorityWarrior"]</xpath>
		<value>
			<li Class="VanillaPsycastsExpanded.PawnKindAbilityExtension_Psycasts">
