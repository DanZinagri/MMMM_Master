				<initialLevel>1</initialLevel>
				<statUpgradePoints>0~0</statUpgradePoints>
				<unlockedPaths>
					<VPE_Conflagrator>1~4|1~10</VPE_Conflagrator>
				</unlockedPaths>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/PawnKindDef[defName="BS_Satan"]/xenotypeSet</xpath>
		<value>
			<xenotypeSet Inherit="False">
				<xenotypeChances>
					<BS_Satan>999999</BS_Satan>
				</xenotypeChances>
			</xenotypeSet>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/PawnKindDef[defName="BS_AuthorityWarrior"]/xenotypeSet</xpath>
		<value>
			<xenotypeSet Inherit="False">
				<xenotypeChances>
					<BS_Authority>999999</BS_Authority>
				</xenotypeChances>
			</xenotypeSet>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/PawnKindDef[defName="BS_ServitorBasic"]/xenotypeSet</xpath>
		<value>
			<xenotypeSet Inherit="False">
