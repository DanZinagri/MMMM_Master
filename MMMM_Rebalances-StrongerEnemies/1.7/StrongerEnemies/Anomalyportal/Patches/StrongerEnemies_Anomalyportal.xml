<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.7/Patches/StrongerEnemies.xml: the operations that also need 22.anomalyportal. -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="AP_MetalStorm"]/statBases/ArmorRating_Sharp</xpath>
		<value>
			<ArmorRating_Sharp>1.5</ArmorRating_Sharp>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="AP_MetalStorm"]/statBases/ArmorRating_Blunt</xpath>
		<value>
			<ArmorRating_Blunt>1.0</ArmorRating_Blunt>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="AP_MetalStorm"]/statBases/ArmorRating_Heat</xpath>
		<value>
			<ArmorRating_Heat>0.5</ArmorRating_Heat>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="AP_MetalStorm"]/tools/li[label="left blade" or label="right blade"]</xpath>
		<value>
			<armorPenetration>1.5</armorPenetration>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="AP_Projectile_TeleportSpike"]/projectile</xpath>
		<value>
			<armorPenetrationBase>1.5</armorPenetrationBase>
		</value>
	</Operation>

</Patch>
