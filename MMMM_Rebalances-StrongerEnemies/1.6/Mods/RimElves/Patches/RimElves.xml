<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Rim-Elves: the elven archer's weapon budget goes from 105~180 to 300~1000, so it spawns with a better bow.
		This folder only loads when Rim-Elves is active (see loadFolders.xml).
		Verified against Rim-Elves 1.6: RE_Elven_Archer ships weaponMoney 105~180.
	-->
	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationReplace">
				<xpath>Defs/PawnKindDef[defName="RE_Elven_Archer"]/weaponMoney</xpath>
				<value>
					<weaponMoney>300~1000</weaponMoney>
				</value>
			</li>
		</operations>
	</Operation>

</Patch>
