<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.6/Without/MedievalOverhaulRoyalty/Patches/MedievalOverhaulRoyalty_StrongerEnemies.xml: the operations that also need Vanilla Psycasts Expanded and Vanilla Armour Expanded. -->

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/PawnKindDef[defName="Empire_Caster_Warlord_Ranged"]</xpath>
		<value>
			<apparelRequired Inherit="False">
				<li>VAE_Headgear_RoyalSiegeHelmet</li>
				<li>VAE_Apparel_RoyalSiegeArmor</li>
			</apparelRequired>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/PawnKindDef[defName="Empire_Caster_Warlord_Melee"]/apparelRequired</xpath>
		<value>
			<apparelRequired Inherit="False">
				<li>VAE_Headgear_RoyalSiegeHelmet</li>
				<li>VAE_Apparel_RoyalSiegeArmor</li>
				<li>Apparel_ShieldBelt</li>
			</apparelRequired>
		</value>
	</Operation>

</Patch>
