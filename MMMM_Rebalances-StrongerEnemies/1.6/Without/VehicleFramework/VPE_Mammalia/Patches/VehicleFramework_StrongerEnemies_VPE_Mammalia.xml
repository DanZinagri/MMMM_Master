<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Moved here from the root file 1.6/Patches/StrongerEnemies.xml.
		This folder loads only when SmashPhil.VehicleFramework is NOT active (see loadFolders.xml). The same condition used to be a
		PatchOperationFindMod on the mod's display name; the load-folder gate uses its packageId instead.
	-->

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/FactionDef[defName="TribeCivilMammals" or defName="TribeRoughMammals"]/pawnGroupMakers/li[position()=1 or position()=2 or position()=3]/options</xpath>
		<value>
			<Tribal_Caster_Frostshaper>0.8</Tribal_Caster_Frostshaper>
			<Tribal_Caster_Staticlord>0.8</Tribal_Caster_Staticlord>
			<Tribal_Caster_Wildspeaker>0.4</Tribal_Caster_Wildspeaker>
		</value>
	</Operation>

</Patch>
