<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		VFE Medieval 2. This folder only loads when VFE Medieval 2 is active (see loadFolders.xml).
		  - The travelling merchant guild also fields Det's Brawnum and Boglegs (0.1 each, each MayRequire'd).
		  - The warbow can also be made at a crafting spot (upstream: smithies only).
		  - The heavy plate helmet stops inheriting the machining table from its parent, so it is smithy-only.
		  - The palisade no longer holds up roofs (upstream: holdsRoof true).
		The last three are VFE Medieval 2 tweaks with no partner mod; the user filed the block under integrations as a whole.
		Verified against VFE Medieval 2 1.6: all four targets exist with the upstream values noted, and neither xenotype is
		already listed. Progression: Attire also appends Medieval Overhaul's anvil to the helmet's recipeUsers, which stacks.
		Split by category into the MMMM Integrations sub-mods: this copy holds only the Factions ops (factions, pawn kinds, traders and royal titles).
	-->
	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationAdd">
				<xpath>Defs/FactionDef[defName="VFEM2_MerchantGuild"]/xenotypeSet/xenotypeChances</xpath>
				<value>
					<DV_Brawnum MayRequire="det.brawnum">0.1</DV_Brawnum>
					<DV_Bogleg MayRequire="det.boglegs">0.1</DV_Bogleg>
				</value>
			</li>
		</operations>
	</Operation>

</Patch>
