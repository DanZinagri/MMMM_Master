<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Moved from the core root file ZZ4_TradeTags.xml (no setting).
		Trade tags so other mods' gear shows up with the right traders:
		  - Biotech: the mechanitor headset, mech commander/mechlord helmets and mechlord suit get the Mechanitor tag; with Alpha
		    Mechs its mech commander/breaker gear too (and, with Royalty, its prestige versions); Rimsenal Spacer traders buy
		    Mechanitor goods.
		  - VFE Empire: deserter and absolver gear become BlackMarket goods (the absolver pieces lose their tradeability limit);
		    with VFE Deserters the fletchling too; Rimsenal Factions' BlackCorp orbital trader and VFE Medieval 2's merchant guild
		    trader buy BlackMarket goods.
		Each block sits in a subfolder gated on its mods. Checked with analysis/patch_sim.py against the installed mods: every op applies
		(the Alpha Mechs prestige defs come from Alpha Mechs' own Royalty patch). Rimsenal Spacer and Rimsenal Factions are not
		installed here; their ids are the ones Too Many Mods gated on.
		Split by category into the MMMM Integrations sub-mods: this copy holds only the Items ops (items: apparel, weapons, food, drugs and loot).
	-->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="Apparel_IntegratorHeadset"]/tradeTags</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="Apparel_IntegratorHeadset"]/tradeTags</xpath>
			<value>
				<li>Mechanitor</li>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="Apparel_IntegratorHeadset"]</xpath>
			<value>
				<tradeTags>
					<li>Mechanitor</li>
				</tradeTags>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="Apparel_ArmorHelmetMechCommander"]/tradeTags</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="Apparel_ArmorHelmetMechCommander"]/tradeTags</xpath>
			<value>
				<li>Mechanitor</li>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="Apparel_ArmorHelmetMechCommander"]</xpath>
			<value>
				<tradeTags>
					<li>Mechanitor</li>
				</tradeTags>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="Apparel_ArmorHelmetMechlordHelmet"]/tradeTags</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="Apparel_ArmorHelmetMechlordHelmet"]/tradeTags</xpath>
			<value>
				<li>Mechanitor</li>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="Apparel_ArmorHelmetMechlordHelmet"]</xpath>
			<value>
				<tradeTags>
					<li>Mechanitor</li>
				</tradeTags>
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="Apparel_MechlordSuit"]/tradeTags</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="Apparel_MechlordSuit"]/tradeTags</xpath>
			<value>
				<li>Mechanitor</li>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="Apparel_MechlordSuit"]</xpath>
			<value>
				<tradeTags>
					<li>Mechanitor</li>
				</tradeTags>
			</value>
		</nomatch>
	</Operation>

</Patch>
