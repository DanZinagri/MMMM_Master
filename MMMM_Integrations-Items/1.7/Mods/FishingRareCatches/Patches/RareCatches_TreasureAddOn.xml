													<qualityGenerator>Reward</qualityGenerator>
													<filter>
														<thingDefs>
															<li>DV_PulseSMG</li>
															<li>DV_PulseRifle</li>
															<li>DV_PulseSuppressor</li>
														</thingDefs>
													</filter>
												</fixedParams>
											</thingSetMaker>
										</li>
									</value>
								</match>
							</li>
							<li Class="PatchOperationFindMod">
								<mods>
									<li>Impact Weaponry - Reloaded</li>
								</mods>
								<match Class="PatchOperationAdd">
									<xpath>Defs/ThingSetMakerDef[@Name="RareFishingCatchesBase"]/root/options</xpath>
									<value>
										<li>
											<weight>0.1</weight>
											<thingSetMaker Class="ThingSetMaker_Count">
												<fixedParams>
													<qualityGenerator>Reward</qualityGenerator>
													<filter>
														<thingDefs>
															<li>DV_Gun_ImpactSlugger</li>
															<li>DV_Gun_ImpactSMG</li>
															<li>DV_Gun_ImpactRifle</li>
															<li>DV_Gun_ImpactStubber</li>
															<li>DV_Gun_ImpactCannon</li>
															<li MayRequire="ebsg.framework">DV_Gun_ImpactSlinger</li>
														</thingDefs>
													</filter>
												</fixedParams>
											</thingSetMaker>
										</li>
									</value>
								</match>
							</li>
							<li Class="PatchOperationFindMod">
								<mods>
									<li>Ion Weaponry (Continued)</li>
								</mods>
								<match Class="PatchOperationAdd">
									<xpath>Defs/ThingSetMakerDef[@Name="RareFishingCatchesBase"]/root/options</xpath>
									<value>
										<li>
											<weight>0.1</weight>
											<thingSetMaker Class="ThingSetMaker_Count">
												<fixedParams>
													<qualityGenerator>Reward</qualityGenerator>
													<filter>
														<thingDefs>
															<li>IW_Gun_IonPistol</li>
															<li>IW_Gun_IonPDW</li>
															<li>IW_Gun_IonDMR</li>
															<li>IW_Gun_IonSlugthrower</li>
															<li>IW_Gun_IonLMG</li>
															<li>IW_Gun_IonRifle</li>
															<li>IW_Gun_HeavyIonLance</li>
														</thingDefs>
													</filter>
												</fixedParams>
											</thingSetMaker>
										</li>
									</value>
								</match>
							</li>
							<li Class="PatchOperationFindMod">
								<mods>
									<li>Rimsenal - Augmented Vanilla Pack</li>
								</mods>
								<match Class="PatchOperationAdd">
									<xpath>Defs/ThingSetMakerDef[@Name="RareFishingCatchesBase"]/root/options</xpath>
									<value>
										<li>
											<weight>0.15</weight>
											<thingSetMaker Class="ThingSetMaker_Count">
												<fixedParams>
													<qualityGenerator>Reward</qualityGenerator>
													<filter>
														<thingDefs>
															<li>Gun_ChargeSidearm</li>
															<li>Gun_ScatterCharger</li>
															<li>Gun_EMPRifle</li>
															<li>Gun_AssaultCharger</li>
															<li>Gun_CFR</li>
															<li MayRequire="Ludeon.RimWorld.Odyssey">Gun_RSBeamCarbine</li>
															<li MayRequire="Ludeon.RimWorld.Odyssey">Gun_RSBeamPistol</li>
															<li MayRequire="Ludeon.RimWorld.Odyssey">Gun_RSBeamSniper</li>
															<li MayRequire="Ludeon.RimWorld.Odyssey">Gun_RSBeamShotgun</li>
															<li>Gun_RSBattleRifle</li>
															<li>Gun_RSCarbine</li>
															<li>Gun_PistolHeavyRevolver</li>
															<li>Gun_RSAMRifle</li>
															<li>Gun_Repeater</li>
															<li>Gun_AutomaticRifle</li>
															<li>Gun_MarksmanRifle</li>
