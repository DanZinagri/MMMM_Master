									<li>
										<weight>0.1</weight>
										<thingSetMaker Class="ThingSetMaker_Count">
											<fixedParams>
												<filter>
													<thingDefs>
														<li>MA_MegaBone</li>
													</thingDefs>
												</filter>
												<countRange>12~30</countRange>
											</fixedParams>
										</thingSetMaker>
									</li>
									<li>
										<weight>0.1</weight>
										<thingSetMaker Class="ThingSetMaker_Count">
											<fixedParams>
												<filter>
													<thingDefs>
														<li>MA_ScarSaberTooth</li>
														<li>MA_DuskhornHorn</li>
													</thingDefs>
												</filter>
											</fixedParams>
										</thingSetMaker>
									</li>
								</value>
							</li>
						</operations>
					</match>
				</li>
				<li Class="PatchOperationFindMod">
