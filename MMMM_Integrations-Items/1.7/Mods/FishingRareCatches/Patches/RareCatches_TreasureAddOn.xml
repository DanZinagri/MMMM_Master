														<li>Gun_HeavySMG</li>
														<li>Gun_LMG</li>
														<li>Gun_AssaultRifle</li>
														<li>Gun_SniperRifle</li>
														<li>Gun_Minigun</li>
													</thingDefs>
												</filter>
											</fixedParams>
										</thingSetMaker>
									</li>
									<li>
										<weight>0.05</weight>
										<thingSetMaker Class="ThingSetMaker_Count">
											<fixedParams>
												<qualityGenerator>Reward</qualityGenerator>
												<filter>
													<thingDefs>
														<li MayRequire="OskarPotocki.VFE.Empire">VFEE_Gun_ChargeThumper</li>
														<li MayRequire="OskarPotocki.VFE.Deserters">VFED_Gun_ChargeCycler</li>
														<!-- not included in VFETA -->
														<li>VWE_SawedOffShotgun</li>
														<li>VWE_CombatHandgun</li>
														<li>VWE_Gun_LeverActionRifle</li>
														<li>VWE_Gun_HMG</li>
														<li>VWE_Gun_ServiceRifle</li>
														<li>VWE_Gun_Carbine</li>
														<li>VWE_Gun_MarksmanRifle</li>
														<li>VWE_Gun_ChargeLMG</li>
														<li>VWE_Gun_ChargeMinigun</li>
														<li>VWE_Gun_ChargeShotgun</li>
													</thingDefs>
												</filter>
											</fixedParams>
										</thingSetMaker>
									</li>
								</value>
							</li>
							<li Class="PatchOperationFindMod">
								<mods>
									<li>Phase Weaponry</li>
								</mods>
								<match Class="PatchOperationAdd">
									<xpath>Defs/ThingSetMakerDef[@Name="RareFishingCatchesBase"]/root/options</xpath>
									<value>
										<li>
											<weight>0.05</weight>
											<thingSetMaker Class="ThingSetMaker_Count">
												<fixedParams>
													<qualityGenerator>Reward</qualityGenerator>
													<filter>
														<thingDefs>
															<li>DV_Gun_PhasePistol</li>
															<li>DV_Gun_PhaseRifle</li>
															<li>DV_Gun_PhasePrecisionRifle</li>
														</thingDefs>
													</filter>
												</fixedParams>
											</thingSetMaker>
										</li>
									</value>
								</match>
							</li>
							<li Class="PatchOperationFindMod">
								<mods>
									<li>Pulse Weaponry</li>
								</mods>
								<match Class="PatchOperationAdd">
									<xpath>Defs/ThingSetMakerDef[@Name="RareFishingCatchesBase"]/root/options</xpath>
									<value>
										<li>
											<weight>0.05</weight>
											<thingSetMaker Class="ThingSetMaker_Count">
