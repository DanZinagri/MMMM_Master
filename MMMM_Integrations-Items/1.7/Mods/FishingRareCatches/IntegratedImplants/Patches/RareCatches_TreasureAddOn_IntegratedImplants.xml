<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.7/Mods/FishingRareCatches/Patches/RareCatches_TreasureAddOn.xml: the operations that also need Integrated Implants. -->

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Fishing Expanded - Treasure AddOn</li>
		</mods>
		<match Class="PatchOperationAdd">
			<xpath>Defs/ThingSetMakerDef[@Name="RareFishingCatchesBase"]/root/options</xpath>
			<value>
				<li MayRequire="ludeon.rimworld.anomaly">
					<weight>0.1</weight>
					<thingSetMaker Class="ThingSetMaker_Count">
						<fixedParams>
							<filter>
								<thingDefs>
									<li>DreadmeldCore</li>
									<li>NociosphereEmitter</li>
									<li>NoctolithSensor</li>
								</thingDefs>
							</filter>
						</fixedParams>
					</thingSetMaker>
				</li>
			</value>
		</match>
	</Operation>

</Patch>
