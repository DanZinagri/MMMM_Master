<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Avaloi glasses are made of glass: with ReBuild - Doors and Corners installed they cost 5 steel and 1 glass
		instead of 12 steel.
		This folder only loads when Det's Xenotypes - Avaloi is active (see loadFolders.xml); ReBuild is gated by subfolder because the glass comes from there.
		Verified against Avaloi 1.6: the upstream cost list is 12 steel.
	-->
	<!--
		Operations that also need another mod sit in a subfolder gated on it in loadFolders.xml. Do not flatten this wrapper away.
	-->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="DV_Headgear_AvaloiGlasses"]/costList</xpath>
		<value>
			<costList>
				<Steel>5</Steel>
				<RB_Glass>1</RB_Glass>
			</costList>
		</value>
	</Operation>

</Patch>
