    <tendable>false</tendable>
    <isBad>false</isBad>
    <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="VEF.Cooking.HediffCompProperties_WhileHavingThoughts">
        <thoughtDefs>
          <li>TMM_VBE_SuspiciousRumAsIngredient</li>
        </thoughtDefs>
      </li>
    </comps>
    <stages>
      <li>
        <hungerRateFactor>0.75</hungerRateFactor>
      </li>
    </stages>
  </HediffDef>

	<ThoughtDef MayRequire="Sarg.AlphaMemes">
    <defName>TMM_VBE_SuspiciousRumAsIngredient</defName>
    <thoughtClass>VEF.Cooking.Thought_Hediff</thoughtClass>
    <hediff>TMM_VBE_SuspiciousRumAsIngredient</hediff>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>Drank suspicious rum based cocktail</label>
        <description>Yummy.</description>
        <baseMoodEffect>0</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

