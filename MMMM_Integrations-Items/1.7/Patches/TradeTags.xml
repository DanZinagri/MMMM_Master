<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Moved from the core root file ZZ4_TradeTags.xml (no setting).
		Trade tags so other mods' gear shows up with the right traders:
		  - Biotech: the mechanitor headset, mech commander/mechlord helmets and mechlord suit get the Mechanitor tag; with Alpha
		    Mechs its mech commander/breaker gear too (and, with Royalty, its prestige versions); Rimsenal Spacer traders buy
		    Mechanitor goods.
		  - VFE Empire: deserter and absolver gear become BlackMarket goods (the absolver pieces lose their tradeability limit);
		    with VFE Deserters the fletchling too; Rimsenal Factions' BlackCorp orbital trader and VFE Medieval 2's merchant guild
		    trader buy BlackMarket goods.
		Each block is gated on its mods via an <li>. Checked with analysis/patch_sim.py against the installed mods: every op applies
		(the Alpha Mechs prestige defs come from Alpha Mechs' own Royalty patch). Rimsenal Spacer and Rimsenal Factions are not
		installed here; their ids are the ones Too Many Mods gated on.
		Split by category into the MMMM Integrations sub-mods: this copy holds only the Items ops (items: apparel, weapons, food, drugs and loot).
	-->
	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationSequence" MayRequire="Ludeon.RimWorld.Biotech">
				<operations>
					<li Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationConditional">
								<xpath>Defs/ThingDef[defName="Apparel_IntegratorHeadset"]/tradeTags</xpath>
								<nomatch Class="PatchOperationAdd">
									<xpath>Defs/ThingDef[defName="Apparel_IntegratorHeadset"]</xpath>
									<value>
										<tradeTags>
											<li>Mechanitor</li>
										</tradeTags>
									</value>
								</nomatch>
								<match Class="PatchOperationAdd">
									<xpath>Defs/ThingDef[defName="Apparel_IntegratorHeadset"]/tradeTags</xpath>
									<value>
										<li>Mechanitor</li>
									</value>
								</match>
							</li>
							<li Class="PatchOperationConditional">
								<xpath>Defs/ThingDef[defName="Apparel_ArmorHelmetMechCommander"]/tradeTags</xpath>
								<nomatch Class="PatchOperationAdd">
									<xpath>Defs/ThingDef[defName="Apparel_ArmorHelmetMechCommander"]</xpath>
									<value>
										<tradeTags>
											<li>Mechanitor</li>
										</tradeTags>
									</value>
								</nomatch>
								<match Class="PatchOperationAdd">
									<xpath>Defs/ThingDef[defName="Apparel_ArmorHelmetMechCommander"]/tradeTags</xpath>
									<value>
										<li>Mechanitor</li>
									</value>
								</match>
							</li>
							<li Class="PatchOperationConditional">
								<xpath>Defs/ThingDef[defName="Apparel_ArmorHelmetMechlordHelmet"]/tradeTags</xpath>
								<nomatch Class="PatchOperationAdd">
									<xpath>Defs/ThingDef[defName="Apparel_ArmorHelmetMechlordHelmet"]</xpath>
									<value>
										<tradeTags>
											<li>Mechanitor</li>
										</tradeTags>
									</value>
								</nomatch>
								<match Class="PatchOperationAdd">
									<xpath>Defs/ThingDef[defName="Apparel_ArmorHelmetMechlordHelmet"]/tradeTags</xpath>
									<value>
										<li>Mechanitor</li>
									</value>
								</match>
							</li>
							<li Class="PatchOperationConditional">
								<xpath>Defs/ThingDef[defName="Apparel_MechlordSuit"]/tradeTags</xpath>
								<nomatch Class="PatchOperationAdd">
									<xpath>Defs/ThingDef[defName="Apparel_MechlordSuit"]</xpath>
									<value>
										<tradeTags>
											<li>Mechanitor</li>
										</tradeTags>
									</value>
								</nomatch>
								<match Class="PatchOperationAdd">
									<xpath>Defs/ThingDef[defName="Apparel_MechlordSuit"]/tradeTags</xpath>
									<value>
										<li>Mechanitor</li>
									</value>
								</match>
							</li>
							<li Class="PatchOperationSequence" MayRequire="sarg.alphamechs">
								<operations>
									<li Class="PatchOperationSequence">
										<operations>
											<li Class="PatchOperationConditional">
												<xpath>Defs/ThingDef[defName="AM_MechCommanderHelm"]/tradeTags</xpath>
												<nomatch Class="PatchOperationAdd">
													<xpath>Defs/ThingDef[defName="AM_MechCommanderHelm"]</xpath>
													<value>
														<tradeTags>
															<li>Mechanitor</li>
														</tradeTags>
													</value>
												</nomatch>
												<match Class="PatchOperationAdd">
													<xpath>Defs/ThingDef[defName="AM_MechCommanderHelm"]/tradeTags</xpath>
													<value>
														<li>Mechanitor</li>
													</value>
												</match>
											</li>
											<li Class="PatchOperationConditional">
												<xpath>Defs/ThingDef[defName="AM_MechBreakerHelm"]/tradeTags</xpath>
												<nomatch Class="PatchOperationAdd">
													<xpath>Defs/ThingDef[defName="AM_MechBreakerHelm"]</xpath>
													<value>
														<tradeTags>
															<li>Mechanitor</li>
														</tradeTags>
													</value>
												</nomatch>
												<match Class="PatchOperationAdd">
													<xpath>Defs/ThingDef[defName="AM_MechBreakerHelm"]/tradeTags</xpath>
													<value>
														<li>Mechanitor</li>
													</value>
												</match>
											</li>
											<li Class="PatchOperationConditional">
												<xpath>Defs/ThingDef[defName="AM_MechCommanderSuit"]/tradeTags</xpath>
												<nomatch Class="PatchOperationAdd">
													<xpath>Defs/ThingDef[defName="AM_MechCommanderSuit"]</xpath>
													<value>
														<tradeTags>
															<li>Mechanitor</li>
														</tradeTags>
													</value>
												</nomatch>
												<match Class="PatchOperationAdd">
													<xpath>Defs/ThingDef[defName="AM_MechCommanderSuit"]/tradeTags</xpath>
													<value>
														<li>Mechanitor</li>
													</value>
												</match>
											</li>
											<li Class="PatchOperationConditional">
												<xpath>Defs/ThingDef[defName="AM_MechBreakerArmor"]/tradeTags</xpath>
												<nomatch Class="PatchOperationAdd">
													<xpath>Defs/ThingDef[defName="AM_MechBreakerArmor"]</xpath>
													<value>
														<tradeTags>
															<li>Mechanitor</li>
														</tradeTags>
													</value>
												</nomatch>
												<match Class="PatchOperationAdd">
													<xpath>Defs/ThingDef[defName="AM_MechBreakerArmor"]/tradeTags</xpath>
													<value>
														<li>Mechanitor</li>
													</value>
												</match>
											</li>
											<li Class="PatchOperationSequence" MayRequire="Ludeon.RimWorld.Royalty">
												<operations>
													<li Class="PatchOperationSequence">
														<operations>
															<li Class="PatchOperationConditional">
																<xpath>Defs/ThingDef[defName="AM_Apparel_ArmorHelmetMechlordHelmet_Prestige"]/tradeTags</xpath>
																<nomatch Class="PatchOperationAdd">
																	<xpath>Defs/ThingDef[defName="AM_Apparel_ArmorHelmetMechlordHelmet_Prestige"]</xpath>
																	<value>
																		<tradeTags>
																			<li>Mechanitor</li>
																		</tradeTags>
																	</value>
																</nomatch>
																<match Class="PatchOperationAdd">
																	<xpath>Defs/ThingDef[defName="AM_Apparel_ArmorHelmetMechlordHelmet_Prestige"]/tradeTags</xpath>
																	<value>
																		<li>Mechanitor</li>
																	</value>
																</match>
															</li>
															<li Class="PatchOperationConditional">
																<xpath>Defs/ThingDef[defName="AM_MechCommanderHelm_Prestige"]/tradeTags</xpath>
																<nomatch Class="PatchOperationAdd">
																	<xpath>Defs/ThingDef[defName="AM_MechCommanderHelm_Prestige"]</xpath>
																	<value>
																		<tradeTags>
																			<li>Mechanitor</li>
																		</tradeTags>
																	</value>
																</nomatch>
																<match Class="PatchOperationAdd">
																	<xpath>Defs/ThingDef[defName="AM_MechCommanderHelm_Prestige"]/tradeTags</xpath>
																	<value>
																		<li>Mechanitor</li>
																	</value>
																</match>
															</li>
															<li Class="PatchOperationConditional">
																<xpath>Defs/ThingDef[defName="AM_PrestigeMechBreakerHelm"]/tradeTags</xpath>
																<nomatch Class="PatchOperationAdd">
																	<xpath>Defs/ThingDef[defName="AM_PrestigeMechBreakerHelm"]</xpath>
																	<value>
																		<tradeTags>
																			<li>Mechanitor</li>
																		</tradeTags>
																	</value>
																</nomatch>
																<match Class="PatchOperationAdd">
																	<xpath>Defs/ThingDef[defName="AM_PrestigeMechBreakerHelm"]/tradeTags</xpath>
																	<value>
																		<li>Mechanitor</li>
																	</value>
																</match>
															</li>
															<li Class="PatchOperationAdd">
																<xpath>Defs/ThingDef[defName="AM_Apparel_MechlordSuit_Prestige" or defName="AM_PrestigeMechCommanderSuit" or defName="AM_PrestigeMechBreakerArmor"]/tradeTags</xpath>
																<value>
																	<li>Mechanitor</li>
																</value>
															</li>
														</operations>
													</li>
												</operations>
											</li>
										</operations>
									</li>
								</operations>
							</li>
						</operations>
					</li>
				</operations>
			</li>
		</operations>
	</Operation>

	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationSequence" MayRequire="OskarPotocki.VFE.Empire">
				<operations>
					<li Class="PatchOperationSequence">
						<operations>
							<li Class="PatchOperationRemove">
								<xpath>Defs/ThingDef[defName="VFEE_Apparel_TechfriarCrown" or defName="VFEE_Apparel_AbsolverHelmet" or defName="VFEE_Apparel_ArmorAbsolver"]/tradeability</xpath>
							</li>
							<li Class="PatchOperationAdd">
								<xpath>Defs/ThingDef[defName="VFEE_Apparel_ArmorDeserter" or defName="VFEE_Apparel_JanissaryCuirass" or defName="VFEE_Apparel_DeserterHelmet" or defName="VFEE_Apparel_JanissaryHelmet"]/tradeTags</xpath>
								<value>
									<li>BlackMarket</li>
								</value>
							</li>
							<li Class="PatchOperationAdd">
								<xpath>Defs/ThingDef[defName="VFEE_Apparel_TechfriarCrown" or defName="VFEE_Apparel_AbsolverHelmet" or defName="VFEE_Apparel_ArmorAbsolver" or defName="VEE_Gun_Fletcher"]</xpath>
								<value>
									<tradeTags>
										<li>BlackMarket</li>
									</tradeTags>
								</value>
							</li>
							<li Class="PatchOperationSequence" MayRequire="OskarPotocki.VFE.Deserters">
								<operations>
									<li Class="PatchOperationSequence">
										<operations>
											<li Class="PatchOperationAdd">
												<xpath>Defs/ThingDef[defName="VFED_Gun_Fletchling"]</xpath>
												<value>
													<tradeTags>
														<li>BlackMarket</li>
													</tradeTags>
												</value>
											</li>
										</operations>
									</li>
								</operations>
							</li>
						</operations>
					</li>
				</operations>
			</li>
		</operations>
	</Operation>

</Patch>
