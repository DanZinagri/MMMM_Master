<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.6/Mods/AncientUrbanRuins/Patches/AncientUrbanRuins.xml: the operations that also need Alpha Crafts and Vanilla Cooking Expanded. -->

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingSetMakerDef[defName="AM_Food"]/root/options</xpath>
		<value>
			<li>
				<weight>1.0</weight>
				<thingSetMaker Class="ThingSetMaker_StackCount">
					<fixedParams>
						<filter>
							<thingDefs>
								<li>AC_SaltedCaramel</li>
								<li>AC_Chutney</li>
							</thingDefs>
						</filter>
						<countRange>2~3</countRange>
					</fixedParams>
				</thingSetMaker>
			</li>
			<li>
				<weight>1.5</weight>
				<thingSetMaker Class="ThingSetMaker_StackCount">
					<fixedParams>
						<filter>
							<thingDefs>
								<li>AC_Jam</li>
								<li>AC_CondensedMilk</li>
								<li MayRequire="VanillaExpanded.VPlantsE">AC_Kimchi</li>
								<li MayRequire="VanillaExpanded.VCookESushi">AC_Miso</li>
							</thingDefs>
						</filter>
						<countRange>5~8</countRange>
					</fixedParams>
				</thingSetMaker>
			</li>
			<li>
				<weight>0.7</weight>
				<thingSetMaker Class="ThingSetMaker_StackCount">
					<fixedParams>
						<filter>
							<thingDefs>
								<li>AC_Molasses</li>
								<li MayRequire="VanillaExpanded.VPlantsEMore">AC_BlackGarlic</li>
							</thingDefs>
						</filter>
						<countRange>12~20</countRange>
					</fixedParams>
				</thingSetMaker>
			</li>
		</value>
	</Operation>

</Patch>
