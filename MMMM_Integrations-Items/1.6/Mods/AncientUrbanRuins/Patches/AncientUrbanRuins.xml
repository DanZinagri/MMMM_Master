<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Ancient Urban Ruins loot: other mods' items join AUR's container loot tables (beverages, food, collectibles, medical
		supplies, tools, injectors, flak apparel), each block gated on the mod that supplies the items. Alpha Crafts also
		restocks the snack racks and double/three-layer racks (the TMM_ArtisanGoods_Large set is in Defs/). With the AUR
		Vanilla-plus-loot add-on and Vanilla Armour Expanded but neither gloves mod, the add-on's boots-and-gloves flak
		option is removed; that check stays a FindMod because it fires on the mods being absent.
		This folder only loads when Ancient Urban Ruins is active (see loadFolders.xml).
		Split by category into the MMMM Integrations sub-mods: this copy holds only the Items ops (items: apparel, weapons, food, drugs and loot).
	-->

	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationSequence" MayRequire="bb.generic.loot.exp.anc.urban.ruins">
				<operations>
					<li Class="PatchOperationSequence" MayRequire="VanillaExpanded.VARME">
						<operations>
							<li Class="PatchOperationFindMod">
								<mods>
									<li>VAE - More Gloves and Boots</li>
									<li>Cat's Boots and Gloves</li>
								</mods>
								<nomatch Class="PatchOperationSequence">
									<operations>
										<!-- remove boots and gloves -->
										<li Class="PatchOperationRemove">
											<xpath>Defs/ThingSetMakerDef[defName="AM_FlakApparel"]/root/options/li[weight=0.1]</xpath>
										</li>
									</operations>
								</nomatch>
							</li>
						</operations>
					</li>
				</operations>
			</li>
		</operations>
	</Operation>

	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationSequence" MayRequire="CatLover366.BootsAndGloves">
				<operations>
					<li Class="PatchOperationAdd">
						<xpath>Defs/ThingSetMakerDef[defName="AM_FlakApparel"]/root/options</xpath>
						<value>
							<li MayRequire="vanillaexpanded.varme">
								<weight>0.1</weight>
								<thingSetMaker Class="ThingSetMaker_Count">
									<fixedParams>
										<filter>
											<thingDefs>
												<li>CAT_Footwear_ReconBoots</li>
												<li>CAT_Footwear_FlakBoots</li>
												<li>CAT_Footwear_RiotBoots</li>
												<li MayRequire="Ludeon.RimWorld.Odyssey">CAT_Footwear_VacsuitBoots</li>
												<li>CAT_Handwear_ReconGloves</li>
												<li>CAT_Handwear_FlakGloves</li>
												<li>CAT_Handwear_RiotGloves</li>
												<li MayRequire="Ludeon.RimWorld.Odyssey">CAT_Handwear_VacsuitGloves</li>
											</thingDefs>
										</filter>
										<countRange>1~1</countRange>
									</fixedParams>
								</thingSetMaker>
							</li>
						</value>
					</li>
				</operations>
			</li>
		</operations>
	</Operation>

