<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.6/Mods/AncientUrbanRuins/Patches/AncientUrbanRuins.xml: the operations that also need Vanilla Brewing Expanded. -->

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingSetMakerDef[defName="AM_Beverages"]/root/options</xpath>
		<value>
			<li>
				<weight>6.0</weight>
				<thingSetMaker Class="ThingSetMaker_StackCount">
					<fixedParams>
						<filter>
							<thingDefs>
								<li>VBE_Whiskey</li>
								<li>VBE_Tequila</li>
								<li>VBE_Vodka</li>
								<li>VBE_Gin</li>
								<li>VBE_Juice</li>
								<li>VBE_Soda</li>
								<li>VBE_EnergyDrink</li>
								<li MayRequire="VanillaExpanded.VPlantsE">VBE_Cider</li>
							</thingDefs>
						</filter>
						<countRange>3~5</countRange>
					</fixedParams>
				</thingSetMaker>
			</li>
			<li>
				<weight>0.5</weight>
				<thingSetMaker Class="ThingSetMaker_StackCount">
					<fixedParams>
						<filter>
							<thingDefs>
								<li>VBE_DoubleWhiskey</li>
								<li MayRequire="Trickity.Samurai.Faction">TSF_Sake</li>
							</thingDefs>
						</filter>
						<countRange>1~3</countRange>
					</fixedParams>
				</thingSetMaker>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingSetMakerDef[defName="AM_Collectible"]/root/options</xpath>
		<value>
			<li>
				<weight>0.1</weight>
				<thingSetMaker Class="ThingSetMaker_StackCount">
					<fixedParams>
						<filter>
							<thingDefs>
								<li>SmokeleafJoint</li>
								<li>VBE_Cigarettes</li>
							</thingDefs>
						</filter>
						<countRange>13~26</countRange>
					</fixedParams>
				</thingSetMaker>
			</li>
			<li>
				<weight>0.1</weight>
				<thingSetMaker Class="ThingSetMaker_StackCount">
					<fixedParams>
						<filter>
							<thingDefs>
								<li>VBE_Cigars</li>
							</thingDefs>
						</filter>
						<countRange>2~4</countRange>
					</fixedParams>
				</thingSetMaker>
			</li>
		</value>
	</Operation>

</Patch>
