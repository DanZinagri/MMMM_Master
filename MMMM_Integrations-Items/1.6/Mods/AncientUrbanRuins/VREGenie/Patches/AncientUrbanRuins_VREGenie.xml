<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.6/Mods/AncientUrbanRuins/Patches/AncientUrbanRuins.xml: the operations that also need Vanilla Races Expanded - Genie. -->

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingSetMakerDef[defName="AM_MedicalSupplies"]/root/options</xpath>
		<value>
			<li>
				<weight>0.1</weight>
				<thingSetMaker Class="ThingSetMaker_StackCount">
					<fixedParams>
						<filter>
							<thingDefs>
								<li>VRE_Antibiotics</li>
							</thingDefs>
						</filter>
						<countRange>8~18</countRange>
					</fixedParams>
				</thingSetMaker>
			</li>
		</value>
	</Operation>

</Patch>
