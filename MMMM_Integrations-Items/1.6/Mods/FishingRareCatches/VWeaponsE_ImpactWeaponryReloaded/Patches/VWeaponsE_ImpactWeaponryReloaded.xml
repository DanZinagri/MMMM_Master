<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Split from 1.6/Mods/FishingRareCatches/Patches/RareCatches_TreasureAddOn.xml: the operations that also need Vanilla Weapons Expanded and Impact Weaponry - Reloaded. -->

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Fishing Expanded - Treasure AddOn</li>
		</mods>
		<match Class="PatchOperationAdd">
			<xpath>Defs/ThingSetMakerDef[@Name="RareFishingCatchesBase"]/root/options</xpath>
			<value>
				<li>
					<weight>0.1</weight>
					<thingSetMaker Class="ThingSetMaker_Count">
						<fixedParams>
							<qualityGenerator>Reward</qualityGenerator>
							<filter>
								<thingDefs>
									<li>DV_Gun_ImpactSlugger</li>
									<li>DV_Gun_ImpactSMG</li>
									<li>DV_Gun_ImpactRifle</li>
									<li>DV_Gun_ImpactStubber</li>
									<li>DV_Gun_ImpactCannon</li>
									<li MayRequire="ebsg.framework">DV_Gun_ImpactSlinger</li>
								</thingDefs>
							</filter>
						</fixedParams>
					</thingSetMaker>
				</li>
			</value>
		</match>
	</Operation>

</Patch>
